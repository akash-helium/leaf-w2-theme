<script>
  class ProductCard extends HTMLElement {
    constructor() {
      super();
      this.track = this.querySelector('.product-card__carousel-track');
      this.images = this.querySelectorAll('.product-card__img');
      this.prevBtn = this.querySelector('.carousel-prev');
      this.nextBtn = this.querySelector('.carousel-next');
      this.progressBar = this.querySelector('.carousel-progress-bar');
      this.progressFill = this.querySelector('.carousel-progress-fill');
      this.currentIndex = 0;
      this.interval = null;
      this.isDraggingBar = false; 
      this.init();
    }

    init() {
      const imageCount = this.images.length;

      if (imageCount <= 1 && this.progressBar) {
        this.progressBar.style.display = 'none';
      }

      if (this.prevBtn && this.nextBtn) {
        [this.prevBtn, this.nextBtn].forEach(btn => {
          btn.addEventListener('click', e => {
            e.preventDefault();
            e.stopPropagation();
          });
        });

        this.prevBtn.addEventListener('click', () => {
          this.stopAutoSwipe();
          this.showImage(this.currentIndex - 1);
        });

        this.nextBtn.addEventListener('click', () => {
          this.stopAutoSwipe();
          this.showImage(this.currentIndex + 1);
        });
      }

      if (this.progressBar && imageCount > 1) {
        this.progressBar.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation(); 
          this.handleBarInteraction(e);
        });

        this.progressBar.addEventListener('mousedown', (e) => {
          this.isDraggingBar = true;
          this.stopAutoSwipe();
        });

        this.addEventListener('mousemove', (e) => {
          if (!this.isDraggingBar) return;
          e.preventDefault(); 
          this.handleBarInteraction(e);
        });

        document.addEventListener('mouseup', () => {
          this.isDraggingBar = false;
        });
      }

      this.addEventListener('mouseenter', () => this.stopAutoSwipe());
      this.addEventListener('mouseleave', () => {
        this.isDraggingBar = false; 
        this.startAutoSwipe();
      });

      this.startAutoSwipe();
      this.updateProgress();
    }

    handleBarInteraction(e) {
      const rect = this.progressBar.getBoundingClientRect();
      const offsetX = e.clientX - rect.left;
      const totalWidth = rect.width;
      
      if (totalWidth === 0) return;

      const percentage = offsetX / totalWidth;
      let targetIndex = Math.floor(percentage * this.images.length);

      targetIndex = Math.max(0, Math.min(targetIndex, this.images.length - 1));

      if (targetIndex !== this.currentIndex) {
        this.showImage(targetIndex);
      }
    }

    showImage(index) {
      if (!this.images.length) return;

      this.currentIndex = (index + this.images.length) % this.images.length;
      
      const offset = -this.currentIndex * 100;
      this.track.style.transform = `translateX(${offset}%)`;

      this.updateProgress();
    }

    updateProgress() {
      if (!this.progressFill || this.images.length <= 1) return;

      const chipWidth = 100 / this.images.length;
      this.progressFill.style.width = `${chipWidth}%`;
      const translatePercent = this.currentIndex * 100; 
      this.progressFill.style.transform = `translateX(${translatePercent}%)`; 
    }

    startAutoSwipe() {
      this.stopAutoSwipe();
      if (this.images.length > 1) {
        this.interval = setInterval(() => {
          this.showImage(this.currentIndex + 1);
        }, 3000);
      }
    }

    stopAutoSwipe() {
      clearInterval(this.interval);
    }
  }

  if (!customElements.get('product-card')) {
    customElements.define('product-card', ProductCard);
  }

  
</script>