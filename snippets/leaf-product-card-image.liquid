{% if product.featured_image and product.metafields.custom.is_video.value == false %}
  <div class="product-card product-card-shadow">
    <a href="{{ product.url }}" class="card-link" aria-label="View {{ product.title }}"></a>
    <div class="product-image">
      <img
        class="normal-image"
        src="{{ product.metafields.custom.transparent_hero_image | img_url:'1104x1104' }}"
        alt="{{ product.title }}"
        loading="lazy"
        width="100%"
        height="auto"
      >

    </div>
    <div class="product-details">
      <h3 class="product-title">{{ product.title }}</h3>
      <div class="price">
        {% if product.compare_at_price > product.price %}
          <span class="original-price">₹{{ product.compare_at_price | money_without_currency }}</span>
          <span class="discounted-price">₹{{ product.price | money_without_currency }}</span>
        {% else %}
          <span class="regular-price">₹{{ product.price | money_without_currency }}</span>
        {% endif %}
      </div>
      <div class="features">
        {% assign tags = product.metafields.custom.feature_list.value %}
        {% if tags and tags.size > 0 %}
          {% for tag in tags limit: 2 %}
            <span class="feature">{{ tag }}</span>
            {% unless forloop.last %}
              <span class="separator">|</span>
            {% endunless %}
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}

<style>
.features {
  font-size: 12px;
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.feature {
  color:var(--brand-bg-muted)
}
.separator {
  color: var(--brand-bg-muted);
  margin-left:2px;
  margin-right:2px;

}
.card-link {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  display: block;
}
</style>
