<style>
  
  .sticky_add_to_cart {
    display: flex;
    position: fixed;
    left: 0;
    width: 100%;
    bottom: 0;
    background: #fff;
    z-index: 99999999;
  }
  .sticky_add_to_cart_inner {
    display: flex;
    width: 100%;
    padding: 5px 0px;
    justify-content: space-between;
  }
  .selected_var_image {
    max-width:90px;
    float:left;
  }
  .selected_var_title_price {
      font-size: 14px;
      float: left;
      max-width: calc(100% - 110px );
  }
/*   span.prod_title {
  //  display: flex;
  } */
  .selected_var_image img {
    padding: 0px 6px 6px 6px;
    max-width: 80px;
  }

  span.button_cart {
/*     background: #f95b07; */
    font-size: 3vw;
    display: flex;
/*     color: #fff; */
    align-items: center;
    justify-content: center;
    margin-top: 4px;
    width: 90%;
    height: 9vw;
    min-height: 30px;
  }
  @media(min-width:1024px){
    .sticky_add_to_cart{
      top:0;
      bottom:auto;
      display: none !important;
    }
    .selected_var_image img {
      max-width: 60px;
    }
    span.button_cart {
      min-height: 30px;
      max-width: 260px;
      max-height: 38px;
      font-size: 14px;
      margin-left: auto;
      margin-right: 30px;
   }
   .selected_var_image {
    text-align: center;
    max-width: 110px;
    margin-left: 15px;
   }
   .logo_container {
    flex-basis: 33.33%;
   }
   .add_button_container {
    flex-basis: 33.33%;
   }
   .img_title {
    flex-basis: 33.33%;
   }
   .sticky_add_to_cart_inner {   
    align-items: center;
   }
  }
  @media(max-width:1024px){
    .stickyHed2 li{
     padding-right: 0 !important;
    } 
    .ProductForm__AddToCart{
      display:none;
    }
    .Popover[aria-hidden="false"]{
       z-index: 999999999;
    }
    .logo_container {
      display: none;
    }
    .img_title {
      flex-basis: 75%;
    }
    .add_button_container {
      flex-basis: 25%;
    }
    .stickyHed2 .img_title {
      opacity:0 !important;
      flex-basis: 0%;
      display: none;
    }
    .stickyHed2 .add_button_container {
      opacity:0 !important;
      flex-basis: 0%;
      display: none;
    }
    .stickyHed2{
/*     	position:relative !important; */
    }
    span.button_cart.btn_animation{
        transition: all .2s ease-out;
    }
  }
  @media(min-width:480px) and (max-width:1024px){
    span.button_cart {
    font-size: 14px !important;
    height: 40px !IMPORTANT;
    max-width: 200px;
   }
   .selected_var_image img {
      max-width: 50px;
   }
   .sticky_add_to_cart_inner {
    padding: 10px 0px !important;
   }
  	
  }
</style>