{% comment %} {% assign current_page_title = 'Shop' %}

{% if collection %}
  {% assign current_page_title = collection.title %}
{% elsif page and page.title %}
  {% assign current_page_title = page.title %}
{% endif %}

{% assign current_sort_by = collection.sort_by | default: collection.default_sort_by %}
{% assign current_product_type_param = request.query_parameters['filter.p.product_type'] %}

<div class="collection-header">
  <div class="collection-header__left">
    <h1 class="collection-header__title">
      <span class="title-desktop">{{ current_page_title }}</span>
    </h1>
  </div>
  <div class="collection-header__right">
    <span class="collection-header__product-count">{{ collection.products_count }} Products</span>
  </div>
</div>


<div class="collection-wrapper">
  <div class="collection-tabs">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% assign coll = collections[block.settings.collection] %}
        {% if coll %}
          {% assign tab_active_class = '' %}
          {% if coll.handle == collection.handle %}
            {% assign tab_active_class = 'is-active' %}
          {% endif %}
          <a href="{{ coll.url }}" class="collection-tab {{ tab_active_class }}">
            {{ coll.title }}
          </a>
        {% endif %}
      {% endfor %}
    {% else %}
      {%- comment -%}Fallback: show first 5 collections if no blocks selected{%- endcomment -%}
      {% for coll in collections limit:5 %}
        {% assign tab_active_class = '' %}
        {% if coll.handle == collection.handle %}
          {% assign tab_active_class = 'is-active' %}
        {% endif %}
        <a href="{{ coll.url }}" class="collection-tab {{ tab_active_class }}">
          {{ coll.title }}
        </a>
      {% endfor %}
    {% endif %}
  </div>

  {% if section.settings.show_sort_by %}
    <!-- Desktop Sort By - visible on desktop, hidden on mobile -->
    <div class="collection-sort-by collection-sort-by--desktop">
      <span class="sort-by__label">Sort by</span>
      <div class="sort-by__dropdown-wrapper">
        <select name="SortBy" id="SortByDesktop" class="sort-by__select">
          {% for option in collection.sort_options %}
            <option value="{{ option.value }}" {% if option.value == current_sort_by %}selected="selected"{% endif %}>
              {{ option.name }}
            </option>
          {% endfor %}
        </select>
        <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-caret-down" viewBox="0 0 10 6">
          <path d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill-rule="evenodd"/>
        </svg>
      </div>
    </div>
  {% endif %}
</div>

<!-- Mobile Sort Button - Fixed at bottom (visible on mobile only) -->
{% if section.settings.show_sort_by %}
<div class="mobile-sort-trigger">
  <button id="OpenMobileSort">Sort By <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-caret-down" viewBox="0 0 10 6">
          <path d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill-rule="evenodd"/>
        </svg>
</button>
</div>

<!-- Mobile Sort Overlay -->
<div class="mobile-sort-overlay" id="MobileSortOverlay"></div>

<!-- Mobile Sort Bottom Sheet (visible on mobile only) -->
<div class="mobile-sort-sheet" id="MobileSortSheet">
  <div class="mobile-sort-sheet__header">
    <span>Sort By</span>
    <button class="mobile-sort-sheet__close" id="CloseMobileSort" style="display:none">X</button>
  </div>
  <ul class="mobile-sort-sheet__options">
    {% for option in collection.sort_options %}
      <li class="mobile-sort-sheet__option" data-value="{{ option.value }}">
        {{ option.name }}
      </li>
    {% endfor %}
  </ul>
  <button class="mobile-sort-sheet__view-results" id="ApplyMobileSort">View Results</button>
</div>
{% endif %}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // --- Desktop Sort Logic ---
    const sortSelectDesktop = document.getElementById('SortByDesktop');
    if (sortSelectDesktop) {
      sortSelectDesktop.addEventListener('change', function() {
        const url = new URL(window.location.href);
        url.searchParams.set('sort_by', this.value);
        window.location.href = url.toString();
      });
    }

    // --- Mobile Sort Logic ---
    const openMobileSortBtn = document.getElementById('OpenMobileSort');
    const closeMobileSortBtn = document.getElementById('CloseMobileSort');
    const mobileSortSheet = document.getElementById('MobileSortSheet');
    const mobileSortOverlay = document.getElementById('MobileSortOverlay'); // Select the new overlay element
    const mobileSortOptions = document.querySelectorAll('.mobile-sort-sheet__option');
    const applyMobileSortBtn = document.getElementById('ApplyMobileSort');

    // Get current sort_by from URL or default Liquid value
    const urlParams = new URLSearchParams(window.location.search);
    let currentMobileSortValue = urlParams.get('sort_by') || '{{ collection.sort_by | default: collection.default_sort_by }}';

    // Highlight initial selected option in the mobile sheet
    mobileSortOptions.forEach(option => {
      if (option.dataset.value === currentMobileSortValue) {
        option.classList.add('is-selected');
      }
    });

    if (openMobileSortBtn && mobileSortSheet && closeMobileSortBtn && applyMobileSortBtn && mobileSortOverlay) {
      // Function to close the mobile sort sheet and overlay
      const closeSheet = () => {
        mobileSortSheet.classList.remove('is-open');
        mobileSortOverlay.classList.remove('is-visible'); // Hide overlay
        document.body.style.overflow = ''; // Restore body scrolling
      };

      openMobileSortBtn.addEventListener('click', function(event) {
        event.stopPropagation(); // Prevent this click from immediately propagating to document and closing the sheet
        mobileSortSheet.classList.add('is-open');
        mobileSortOverlay.classList.add('is-visible'); // Show overlay
        document.body.style.overflow = 'hidden'; // Prevent scrolling body when sheet is open
      });

      closeMobileSortBtn.addEventListener('click', function() {
        closeSheet();
      });

      mobileSortOptions.forEach(option => {
        option.addEventListener('click', function() {
          // Remove selected class from all options
          mobileSortOptions.forEach(opt => opt.classList.remove('is-selected'));
          // Add selected class to the clicked option
          this.classList.add('is-selected');
          currentMobileSortValue = this.dataset.value; // Update the selected value
        });
      });

      applyMobileSortBtn.addEventListener('click', function() {
        if (currentMobileSortValue) {
          const url = new URL(window.location.href);
          url.searchParams.set('sort_by', currentMobileSortValue);
          window.location.href = url.toString();
        }
        closeSheet();
      });

      // Close drawer and overlay on outside click
      document.body.addEventListener('click', function(event) {
        if (mobileSortSheet.classList.contains('is-open') &&
            !mobileSortSheet.contains(event.target) &&
            !openMobileSortBtn.contains(event.target)) {
          closeSheet();
        }
      });

      // Close drawer and overlay if overlay itself is clicked
      mobileSortOverlay.addEventListener('click', function() {
        closeSheet();
      });
    }
  });
</script>

