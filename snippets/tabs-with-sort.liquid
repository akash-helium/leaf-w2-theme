{% assign current_page_title = 'Shop' %}
{% if collection %}
  {% assign current_page_title = collection.title %}
{% elsif page and page.title %}
  {% assign current_page_title = page.title %}
{% endif %}

{% assign current_sort_by = collection.sort_by | default: collection.default_sort_by %}

<div class="collection-header">
  <div class="collection-header__left">
    <h1 class="collection-header__title">
      <span class="title-desktop">{{ current_page_title }}</span>
    </h1>
  </div>
  <div class="collection-header__right">
    <span class="collection-header__product-count">{{ collection.products_count }} Products</span>
  </div>
</div>


{%- comment -%}
  STEP 1: Build list → "title||handle"
{%- endcomment -%}

{% assign subcollection_list = "" %}

{% for product in collection.products %}
  {% assign subcol_obj = product.metafields.custom.subcollection.value %}
  
  {% if subcol_obj != blank %}
    {% assign val_title = subcol_obj.title %}
    {% assign val_handle = subcol_obj.handle %}
    
    {% assign subcollection_list = subcollection_list
      | append: val_title
      | append: '||'
      | append: val_handle
      | append: '##' %}
  {% endif %}
{% endfor %}

{%- comment -%}
  STEP 2: Unique + Sort (by title automatically)
{%- endcomment -%}

{% assign unique_subcollections = subcollection_list | split: '##' | uniq %}
{% assign sorted_subcollections = unique_subcollections | sort %}

<div class="collection-wrapper">
  <div class="collection-tabs">

    <!-- ALWAYS FIRST -->
    <a href="#" class="collection-tab is-active" data-filter="all">
      All
    </a>

    {%- comment -%}
      STEP 3: Render sorted tabs
    {%- endcomment -%}
    {% for item in sorted_subcollections %}
      {% assign parts = item | split: '||' %}
      {% assign val_title = parts[0] %}
      {% assign val_handle = parts[1] %}
      
      {% if val_handle != blank %}
        <a href="#" class="collection-tab" data-filter="{{ val_handle }}">
          {{ val_title }}
        </a>
      {% endif %}
    {% endfor %}

  </div>

  {% if section.settings.show_sort_by %}
    <div class="collection-sort-by collection-sort-by--desktop">
      <span class="sort-by__label">Sort by</span>
      <div class="sort-by__dropdown-wrapper">
        <select name="SortBy" id="SortByDesktop" class="sort-by__select">
          {% for option in collection.sort_options %}
            <option value="{{ option.value }}" {% if option.value == current_sort_by %}selected="selected"{% endif %}>
              {{ option.name }}
            </option>
          {% endfor %}
        </select>
      </div>
    </div>
  {% endif %}
</div>


<script>
  document.addEventListener('DOMContentLoaded', function() {
    
    // --- METAFIELD FILTERING LOGIC ---
    const filterTabs = document.querySelectorAll('.collection-tab');
    
    filterTabs.forEach(tab => {
      tab.addEventListener('click', function(e) {
        e.preventDefault();
        
        // 1. Manage Active State
        filterTabs.forEach(t => t.classList.remove('is-active'));
        this.classList.add('is-active');
        
        // 2. Get Filter Value
        const filterValue = this.getAttribute('data-filter');
        
        // 3. Filter Grid Items
        const productItems = document.querySelectorAll('.ProductList .Grid__Cell');
        
        productItems.forEach(item => {
          if (filterValue === 'all') {
            item.style.display = ''; // Restore default display
          } else {
            // Check the data attribute we added in collection-template
            const itemSubcol = item.getAttribute('data-subcollection');
            if (itemSubcol === filterValue) {
              item.style.display = '';
            } else {
              item.style.display = 'none';
            }
          }
        });
      });
    });


    // --- Desktop Sort Logic ---
    const sortSelectDesktop = document.getElementById('SortByDesktop');
    if (sortSelectDesktop) {
      sortSelectDesktop.addEventListener('change', function() {
        const url = new URL(window.location.href);
        url.searchParams.set('sort_by', this.value);
        window.location.href = url.toString();
      });
    }

    // --- Mobile Sort Logic ---
    const openMobileSortBtn = document.getElementById('OpenMobileSort');
    const closeMobileSortBtn = document.getElementById('CloseMobileSort');
    const mobileSortSheet = document.getElementById('MobileSortSheet');
    const mobileSortOverlay = document.getElementById('MobileSortOverlay');
    const mobileSortOptions = document.querySelectorAll('.mobile-sort-sheet__option');
    const applyMobileSortBtn = document.getElementById('ApplyMobileSort');

    const urlParams = new URLSearchParams(window.location.search);
    let currentMobileSortValue = urlParams.get('sort_by') || '{{ collection.sort_by | default: collection.default_sort_by }}';

    mobileSortOptions.forEach(option => {
      if (option.dataset.value === currentMobileSortValue) {
        option.classList.add('is-selected');
      }
    });

    if (openMobileSortBtn && mobileSortSheet && closeMobileSortBtn && applyMobileSortBtn && mobileSortOverlay) {
      const closeSheet = () => {
        mobileSortSheet.classList.remove('is-open');
        mobileSortOverlay.classList.remove('is-visible');
        document.body.style.overflow = '';
      };

      openMobileSortBtn.addEventListener('click', function(event) {
        event.stopPropagation();
        mobileSortSheet.classList.add('is-open');
        mobileSortOverlay.classList.add('is-visible');
        document.body.style.overflow = 'hidden';
      });

      closeMobileSortBtn.addEventListener('click', function() {
        closeSheet();
      });

      mobileSortOptions.forEach(option => {
        option.addEventListener('click', function() {
          mobileSortOptions.forEach(opt => opt.classList.remove('is-selected'));
          this.classList.add('is-selected');
          currentMobileSortValue = this.dataset.value;
        });
      });

      applyMobileSortBtn.addEventListener('click', function() {
        if (currentMobileSortValue) {
          const url = new URL(window.location.href);
          url.searchParams.set('sort_by', currentMobileSortValue);
          window.location.href = url.toString();
        }
        closeSheet();
      });

      document.body.addEventListener('click', function(event) {
        if (mobileSortSheet.classList.contains('is-open') &&
            !mobileSortSheet.contains(event.target) &&
            !openMobileSortBtn.contains(event.target)) {
          closeSheet();
        }
      });

      mobileSortOverlay.addEventListener('click', function() {
        closeSheet();
      });
    }
  });
</script>

