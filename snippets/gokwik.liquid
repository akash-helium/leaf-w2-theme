{% comment %} {% if settings.envType == 'production' %}
{% assign env = 'pdp' %}
{% elsif settings.envType == 'sandbox' %}
{% assign env = 'sandbox.pdp' %}
{%endif%}

<script>
  window.merchantInfo  = {
          mid: "{{ settings.mid }}",
          environment: "{{ settings.envType }}",
          type: "merchantInfo",
    		storeId: "{{shop.id}}",
    		fbpixel: "{{settings.fbpixel}}",
        }
  var productFormSelector = ''
  var cart = {{ cart | json }}
  var templateName = '{{template.name}}'
</script>

<!-- <script src="https://{{env}}.gokwik.co/build/merchant.integration.js?shop={{ shop.url }}"></script>   -->
<script src="https://{{env}}.gokwik.co/merchant-integration/build/merchant.integration.js?shop={{ shop.url }}"></script>
<script src="https://analytics.gokwik.co/analytics.js" id="gokwikHeaderAnalytics"></script>

<style>
{% if settings.goEnable %}
.gokwik-checkout {
  width: 100%;
  display: flex;
  justify-content: center;
  flex-direction: column;
  align-items: end;
  margin-bottom: 10px;
}
.gokwik-checkout button {
  max-width: 350px!important;
  width: 100%!important;
  border: 1px solid #000;
  display: flex;
  justify-content: center;
  align-items: center;
  background: {{ settings.priClr }};
  position: relative;
  margin: 0;
  border-radius: 0px;
  padding:8px 10px!important;
}
#gokwik-buy-now.disabled, .gokwik-disabled{
  opacity:0.5;
  cursor: not-allowed;
  }
  .gokwik-checkout button:focus {
  outline: none;
}
.gokwik-checkout button > span {
  display: flex;
}
.gokwik-checkout button > span.btn-text {
  display: flex;
  flex-direction: column;
  color: {{ settings.secClr }};
  align-items: center;
}
.gokwik-checkout button > span.btn-text > span:last-child {
	padding-top: 3px;
    font-size: 8px;
    line-height: 10px;
}
.gokwik-checkout button > span.btn-text > span:first-child {
   
}
.gokwik-checkout button > span.pay-opt-icon img:first-child {
  margin-right: 10px;
  margin-left: 10px;
}
/* aditionl */

button.Cart__Checkout.Button.Button--primary.Button--full {
    max-width: 100%;
    padding: 12px 50px;
  height: 60px;
}
  
.shopify-payment-button__button {
    color: #ffffff !important;
    font-size: 12px;
    line-height: 1.4 !important;
    background-color: #000000 !important;
  border-radius: 0px !important;
}
.shopify-payment-button__button--unbranded:hover:not([disabled]) {
    color: #FFF !IMPORTANT;
}
  
.shopify-payment-button__button--unbranded::before {
    background-color: #000000 !important;
    border-radius: 0px;
    color: #fff;
    border: 1px solid rgba(106,106,106,.2);
}
 .shopify-payment-button__button--unbranded::after {
    background-color: #000000 !important;
    border-radius: 0px;
    color: #fff;
    border: 1px solid rgba(106,106,106,.2);
}

.shopify-payment-button__button--unbranded:not([disabled]):before{
  transition:none;
}
  .shopify-payment-button__button--unbranded:not([disabled]):after{
  transition:none;
    border-radius: 0px !importat;
}
  
.gokwik-checkout button:hover > span.btn-text > span:first-child{
  color:#000;
}
  
.gokwik-checkout button:hover > span.btn-text > span:last-child{
  color:#000;
}
.gokwik-checkout button:hover span.pay-opt-icon img:last-child {
    filter: invert(1);
}
.Drawer__Footer button.Cart__Checkout.Button.Button--primary.Button--full {
    padding: 7px 22px;
}
@media(max-width:640px){
.gokwik-checkout button {
    max-width: 100%!important;
    width: 100%!important;
}
.Cart--expanded .Cart__Checkout {
    padding: 14px 10px!imporatnt;
    font-size: 11px!important;
}
  .Drawer {
    width: calc(100vw - 20px)!important;
}
  .Drawer__Footer button.Cart__Checkout.Button.Button--primary.Button--full {
    font-size:11px!important;
}
}
@media(min-width:641px){
.Cart--expanded .Cart__Recap, .Cart--expanded .Cart__Recap .Cart__Checkout {
    margin-top: 16px;
    max-width: 68% !important;}
  .Button--full {
    width: 68% !important;
    
}}
 
  
{% endif %}
  
{% if settings.goBuynowEnable %}
 #gokwik-buy-now {
   background: #1c1b1b;
    max-width: 600px;
    width: 100%;
    color: #ffffff;
   cursor: pointer;
   line-height: 1;
   border: none;
   padding: 15px 10px;
   margin-top: 15px;
    text-transform: uppercase;
    position: relative;
    letter-spacing: .2em;
    font-size: 13px;
    border: 1px solid #e1e1e1;
 }
#gokwik-buy-now:hover {
  color:#fff!important;
}
  
{% endif %}
/* Loader CSS */
  #btn-loader{
    display: none;
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    justify-content: center;
    align-items: center;
    background:{{ settings.priClr }};
    border-radius:0;
    
  } 

.cir-loader,
.cir-loader:after {
  border-radius: 50%;
  width: 35px;
  height: 35px;
}
.cir-loader {
  margin: 6px auto;
  font-size: 10px;
  position: relative;
  text-indent: -9999em;
  border-top: 0.5em solid rgba(255, 255, 255, 0.2);
  border-right: 0.5em solid rgba(255, 255, 255, 0.2);
  border-bottom: 0.5em solid rgba(255, 255, 255, 0.2);
  border-left: 0.5em solid #ffffff;
  -webkit-transform: translateZ(0);
  -ms-transform: translateZ(0);
  transform: translateZ(0);
  -webkit-animation: load8 1.1s infinite linear;
  animation: load8 1.1s infinite linear;
}
@-webkit-keyframes load8 {
  0% {
    -webkit-transform: rotate(0deg);
    transform: rotate(0deg);
  }
  100% {
    -webkit-transform: rotate(360deg);
    transform: rotate(360deg);
  }
}
@keyframes load8 {
  0% {
    -webkit-transform: rotate(0deg);
    transform: rotate(0deg);
  }
  100% {
    -webkit-transform: rotate(360deg);
    transform: rotate(360deg);
  }
}
</style>  {% endcomment %}
