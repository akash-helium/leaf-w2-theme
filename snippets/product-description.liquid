    <script>
  // Add an event listener to the body for all click events.
  document.body.addEventListener('click', function(event) {
    
    // Check if the element that was clicked, or one of its ancestors,
    // has the class 'button_cart'.
    if (event.target.closest('.button_cart')) {
      
      // If it does, find the span inside the main product form's add-to-cart button.
      const mainAddToCartSpan = document.querySelector('.ProductForm__AddToCart span');
      
      // As a safeguard, check if that element actually exists before trying to click it.
      if (mainAddToCartSpan) {
        // Programmatically trigger a click on the main add-to-cart button.
        mainAddToCartSpan.click();
      }
    }
  });
</script>