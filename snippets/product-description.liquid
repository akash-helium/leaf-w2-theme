</script> {% endcomment %}



 <script>
  // Wait for the HTML document to be fully loaded before running the script.
  document.addEventListener('DOMContentLoaded', function() {
    
    // Select all the tab links within elements having the 'common_class_custom' class.
    const tabLinks = document.querySelectorAll('.common_class_custom li a');

    // Define the function that will handle the click event.
    function handleTabClick(event) {
      // Prevent the default link behavior, which is to jump to the anchor.
      event.preventDefault();

      // Loop through all the tab links and remove the 'tab_active' class from each one.
      tabLinks.forEach(function(link) {
        link.classList.remove('tab_active');
      });

      // Add the 'tab_active' class to the specific link that was just clicked.
      // 'this' refers to the element that triggered the event.
      this.classList.add('tab_active');
    }

    // Attach the click event listener to every tab link.
    tabLinks.forEach(function(link) {
      link.addEventListener('click', handleTabClick);
    });
    
  });
</script>



