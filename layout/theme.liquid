  <script>
document.addEventListener("DOMContentLoaded", function () {

  const slider = document.querySelector('.first-slider');
  if (!slider) return;

  const wrapper = slider.querySelector('.media-wrapper');
  const items = slider.querySelectorAll('.media-item');
  const nextBtn = slider.querySelector('.arrow.right');
  const prevBtn = slider.querySelector('.arrow.left');

  let current = 0;
  const total = items.length;

  function updateSlide() {
    wrapper.style.transform = `translateX(-${current * 100}%)`;
  }

  function nextSlide() {
    current = (current + 1) % total;
    updateSlide();
  }

  function prevSlide() {
    current = (current - 1 + total) % total;
    updateSlide();
  }

  // Auto slide
  setInterval(nextSlide, 2000);

  // Arrows
  nextBtn.addEventListener('click', (e) => {
    e.preventDefault();
    nextSlide();
  });

  prevBtn.addEventListener('click', (e) => {
    e.preventDefault();
    prevSlide();
  });

});
document.addEventListener("DOMContentLoaded", function () {

  const sliders = document.querySelectorAll('.product-media-slider');

  sliders.forEach((slider, index) => {

    const wrapper = slider.querySelector('.media-wrapper');
    const items = slider.querySelectorAll('.media-item');
    const nextBtn = slider.querySelector('.arrow.right');
    const prevBtn = slider.querySelector('.arrow.left');

    if (!wrapper || items.length === 0) return;

    let current = 0;
    let interval = null;
    const total = items.length;

    let startX = 0;
    let currentTranslate = 0;
    let isDragging = false;

    function updateSlide(animated = true) {
      wrapper.style.transition = animated ? 'transform 0.35s ease' : 'none';
      wrapper.style.transform = `translateX(-${current * 100}%)`;
    }

    function nextSlide() {
      current = (current + 1) % total;
      updateSlide();
    }

    function prevSlide() {
      current = (current - 1 + total) % total;
      updateSlide();
    }

    /* AUTO/HOVER SLIDE */
    if (index === 0) {
      interval = setInterval(nextSlide, 2000);
    } else {
      slider.addEventListener('mouseenter', () => {
        if (!interval) interval = setInterval(nextSlide, 1500);
      });

      slider.addEventListener('mouseleave', () => {
        clearInterval(interval);
        interval = null;
        current = 0;
        updateSlide();
      });
    }

    /* ARROWS */
    nextBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      nextSlide();
    });

    prevBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      prevSlide();
    });

    /* DRAG / SWIPE SUPPORT */
    function dragStart(x) {
      isDragging = true;
      startX = x;
      wrapper.style.transition = 'none';
    }

    function dragMove(x) {
      if (!isDragging) return;

      const diff = x - startX;
      currentTranslate = (-current * slider.offsetWidth) + diff;

      wrapper.style.transform = `translateX(${currentTranslate}px)`;
    }

    function dragEnd(x) {
      if (!isDragging) return;

      isDragging = false;

      const diff = x - startX;
      const threshold = slider.offsetWidth * 0.2;

      if (diff < -threshold) {
        nextSlide();
      } else if (diff > threshold) {
        prevSlide();
      } else {
        updateSlide();
      }
    }

    /* Mouse Events */
    slider.addEventListener('mousedown', (e) => dragStart(e.clientX));
    window.addEventListener('mousemove', (e) => dragMove(e.clientX));
    window.addEventListener('mouseup', (e) => dragEnd(e.clientX));

    /* Touch Events */
    slider.addEventListener('touchstart', (e) => dragStart(e.touches[0].clientX), { passive: true });
    slider.addEventListener('touchmove', (e) => dragMove(e.touches[0].clientX), { passive: true });
    slider.addEventListener('touchend', (e) => {
      dragEnd(e.changedTouches[0].clientX);
    });

  });

});
  </script>
  
</body>
  
