

<section class="stats-grid-wrapper">
  <div class="page-width">
    <div class="stats-grid-container">
      {%- for block in section.blocks -%}
        {%- liquid
          assign B = block.settings

          assign card_style = ''
          if B.image_bg
            assign card_style = card_style | append: 'background-image: url(' | append: B.image_bg | image_url: width: 1200 | append: ');'
          endif

          assign grid_style = ''
          assign grid_style = grid_style | append: '--grid-col-span-desktop: ' | append: B.desktop_col_span | append: ';'
          assign grid_style = grid_style | append: '--grid-row-span-desktop: ' | append: B.desktop_row_span | append: ';'
          assign grid_style = grid_style | append: '--mobile-order: ' | append: B.mobile_order | append: ';'
        -%}

        <div
          class="stat-card stat-card--{{ B.card_style }} align--{{ B.content_align }}"
          style="{{ grid_style }}"
          {{ block.shopify_attributes }}
        >
          <div class="stat-card__bg-image" style="{{ card_style }}"></div>
          <div class="stat-card__content">

            {%- if B.icon != blank -%}
              <div class="stat-card__icon-wrapper">
                <img src="{{ B.icon | image_url: width: 40 }}" alt="{{ B.icon.alt | escape }}" loading="lazy" class="stat-card__icon">
              </div>
            {%- endif -%}

            {%- if B.heading != blank -%}
              <p class="stat-card__heading">{{ B.heading }}</p>
            {%- endif -%}

            {%- if B.large_text != blank -%}
              <p class="stat-card__large-text {% if B.use_gradient_text %}text-gradient{% endif %}">
                {{ B.large_text }}
              </p>
            {%- endif -%}

            {%- if B.subheading != blank -%}
              <p class="stat-card__subheading {% if B.use_gradient_text_subheading %}text-gradient{% endif %}">
                {{ B.subheading }}
              </p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>


<style>
  .stats-grid-wrapper {
    padding: 50px 0;
    font-family: 'Poppins', sans-serif;
  }

  .stats-grid-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .stat-card {
    --card-bg: var(--brand-bg);
    --card-color: var(--brand-primary-color-font-body);
    --card-radius: 24px;
    --card-padding: 24px;

    background-color: var(--card-bg);
    color: var(--card-color);
    border-radius: var(--card-radius);
    padding: var(--card-padding);
    position: relative;
    overflow: hidden;

    display: flex;
    flex-direction: column;
    grid-column: span var(--grid-col-span-desktop, 1);
    grid-row: span var(--grid-row-span-desktop, 1);
  }

  .stat-card__bg-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    z-index: 0;
  }

  .stat-card__content {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  /* --- CARD STYLE MODIFIERS --- */
  .stat-card--gradient {
    --card-bg: var(--brand-bg-gradient);
    --card-color: var(--card-text-primary);
  }
  .stat-card--image-only {
    padding: 0;
  }
  .stat-card--image-only img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--card-radius);
  }

  .stat-card.align--top .stat-card__content { justify-content: flex-start; }
  .stat-card.align--center .stat-card__content { justify-content: center; text-align: center; }
  .stat-card.align--bottom .stat-card__content { justify-content: flex-end; }
  .stat-card.align--space-between .stat-card__content { justify-content: space-between; }


  .stat-card__heading {
    font-size: 14px;
    font-weight: 500;
    opacity: 0.8;
    margin: 0 0 8px 0;
  }

  .stat-card__large-text {
    font-size: 48px;
    font-weight: 600;
    line-height: 1.1;
    margin: 0;
  }
  
  .stat-card__subheading {
    font-size: 14px;
    font-weight: 500;
    margin: 8px 0 0 0;
  }

  .stat-card__icon-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--brand-bg-muted);
    border: 1px solid var(--brand-border-muted);
    color: var(--brand-primary-color-font-body);
    padding: 8px 16px;
    border-radius: 99px;
    backdrop-filter: blur(10px);
    width: fit-content;
    margin-bottom: auto; /* Pushes to the top in space-between */
  }
  
  .stat-card__icon-wrapper p {
    margin: 0;
  }

  .stat-card__icon {
    width: 20px;
    height: 20px;
  }


  @media (max-width: 768px) {
    .stats-grid-container {
      grid-template-columns: 1fr;
    }
    .stat-card {
      grid-column: auto;
      grid-row: auto;
      order: var(--mobile-order, 0);
      min-height: 200px; /* Ensure cards have some height */
    }
    .stat-card__large-text {
      font-size: 36px;
    }
  }
</style>

{% schema %}
{
  "name": "Feature Stats Grid",
  "class": "feature-stats-grid-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "paragraph",
      "content": "Create a grid of feature cards. Use the blocks below to add and configure each card."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Stat Card",
      "settings": [
        {
          "type": "header",
          "content": "Card Content"
        },
        {
          "type": "select",
          "id": "card_style",
          "label": "Card Style",
          "options": [
            { "value": "default", "label": "Default (Dark)" },
            { "value": "gradient", "label": "Gradient Background" },
            { "value": "image-only", "label": "Image Only" }
          ],
          "default": "default"
        },
        {
          "type": "image_picker",
          "id": "image_bg",
          "label": "Background Image",
          "info": "Used for 'Default' style. Will appear behind content."
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "Small icon for badges, e.g., star or flag."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Trusted by"
        },
        {
          "type": "text",
          "id": "large_text",
          "label": "Large Text / Main Stat",
          "default": "15L+"
        },
        {
          "type": "checkbox",
          "id": "use_gradient_text",
          "label": "Use gradient for Large Text?",
          "default": false
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Satisfied Users"
        },
        {
          "type": "checkbox",
          "id": "use_gradient_text_subheading",
          "label": "Use gradient for Subheading?",
          "default": false
        },
        {
          "type": "header",
          "content": "Layout & Alignment"
        },
        {
          "type": "select",
          "id": "content_align",
          "label": "Content Alignment",
          "options": [
            { "value": "center", "label": "Center" },
            { "value": "bottom", "label": "Bottom" },
            { "value": "top", "label": "Top" },
            { "value": "space-between", "label": "Space Between" }
          ],
          "default": "space-between"
        },
        {
          "type": "select",
          "id": "desktop_col_span",
          "label": "Desktop Column Span",
          "options": [
            { "value": "1", "label": "1" },
            { "value": "2", "label": "2" },
            { "value": "3", "label": "3" }
          ],
          "default": "1"
        },
        {
          "type": "select",
          "id": "desktop_row_span",
          "label": "Desktop Row Span",
          "options": [
            { "value": "1", "label": "1" },
            { "value": "2", "label": "2" }
          ],
          "default": "1"
        },
        {
          "type": "number",
          "id": "mobile_order",
          "label": "Mobile Order",
          "info": "Order on mobile (1 is first, 2 is second...).",
          "default": 1
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Stats Grid",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}