<section
  class="exploded-image-parallax"
  {% if section.settings.image %}
    data-bg-image="{{ section.settings.image | image_url: width: 2000 }}"
  {% endif %}
>
  <div class="parallax-bg-container">
    {% if section.settings.image %}
      <div
        class="parallax-bg"
        style="background-image: url({{ section.settings.image | image_url: width: 2000 }});"
      ></div>
    {% endif %}
  </div>

  <noscript>
    {% if section.settings.image %}
      <div
        class="parallax-fallback"
        style="background-image: url({{ section.settings.image | image_url: width: 2000 }});"
      ></div>
    {% endif %}
  </noscript>
</section>

<style>
  .exploded-image-parallax {
    width: 100vw;
    height: 80vh;
    position: relative;
    box-sizing: border-box;
    margin-top: 20px;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    overflow: hidden;
    transform: translateZ(0);
  }

  .parallax-bg-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .parallax-bg {
    position: absolute;
    left: 0;
    width: 100%;
    /* Give the element more height and position it higher to allow for movement */
    height: 150%;
    top: -25%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    will-change: transform;
    transform: translateZ(0);
    transition: transform 0.1s ease-out;
  }

  .parallax-fallback {
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  @media (max-width: 1024px) {
    .exploded-image-parallax {
      height: 60vh;
    }
    .parallax-bg {
       /* On mobile, fixed attachment can be jittery, transform is better */
      background-attachment: scroll;
    }
  }

  @media (max-width: 480px) {
    .exploded-image-parallax {
      height: 50vh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .parallax-bg {
      transform: none !important;
      height: 100%;
      top: 0;
    }
  }
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const parallaxEl = document.querySelector(".exploded-image-parallax");
    const parallaxBg = document.querySelector(".parallax-bg");
    
    if (!parallaxEl || !parallaxBg) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      return;
    }

    const isSafari = /^((?!chrome|android).)*safari/i.test(navigator.userAgent);
    let ticking = false;
    let isInView = false;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          isInView = entry.isIntersecting;
          if (isInView) {
            window.addEventListener("scroll", handleScroll, { passive: true });
            handleScroll(); // Initial call
          } else {
            window.removeEventListener("scroll", handleScroll);
          }
        });
      },
      { threshold: 0 }
    );

    observer.observe(parallaxEl);

    function handleScroll() {
      if (!isInView || ticking) return;

      ticking = true;
      requestAnimationFrame(() => {
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        const elOffsetTop = parallaxEl.offsetTop;
        const elHeight = parallaxEl.offsetHeight;

        if (scrollTop + window.innerHeight >= elOffsetTop && scrollTop <= elOffsetTop + elHeight) {
          // A single, universal parallax calculation for all devices
          const parallaxSpeed = 0.4;
          const yPos = (elOffsetTop - scrollTop) * parallaxSpeed;
          
          // Use translate3d for hardware acceleration, but fallback to translateY for Safari if needed
          const transformValue = isSafari 
              ? `translateY(${yPos}px)`
              : `translate3d(0, ${yPos}px, 0)`;

          parallaxBg.style.transform = transformValue;
        }
        ticking = false;
      });
    }

    window.addEventListener("resize", handleScroll, { passive: true });

    window.addEventListener("beforeunload", () => {
      observer.disconnect();
      window.removeEventListener("scroll", handleScroll);
      window.removeEventListener("resize", handleScroll);
    });
});
</script>

{% schema %}
{
  "name": "Image Parallax",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    }
  ],
  "presets": [
    {
      "name": "Image Parallax"
    }
  ]
}
{% endschema %}