{% assign font_family = section.settings.font_head1 %}
{% assign head_family = section.settings.font_head2 %}
{% assign button_family = section.settings.font_setting_btn %}

<div class="video-wrapper">
  <div class="Video_wrapper_content postion_{{ section.settings.position }} align_{{ section.settings.alignment0 }}">
    {% if section.settings.head1 != blank %} <h1 class="Video_wrapper_contenth1">{{ section.settings.head1 }}</h1>{% endif %}
    {% if section.settings.head2 != blank %} <h3 class="Video_wrapper_contenth3">{{ section.settings.head2 }}</h3>{% endif %}
     {% if section.settings.video_url != blank %}<a data-fancybox="video-gallery"class="fancybox" data-src="{{ section.settings.video_url }}" data-width="100%" data-height="100%">
  	 {% if section.settings.button != blank %}<button class="btn Video_wrapper_contenthbtn">{{ section.settings.button }}</button>{% endif %}   
    </a>{% endif %}
  </div>
  {% if section.settings.show_iframe %}
  <iframe src="{{ section.settings.video_url2 }}?autoplay=1&loop=1&mute=1{% if section.settings.videoid != blank %}&playlist={{ section.settings.videoid }}{% endif %}" width="100%" height="700px" class="video-container video-container-overlay embed-responsive" id="vid" allow=autoplay allowfullscreen="" frameborder="0">
  </iframe>
  {% endif %}
  {% if section.settings.show_video %}
  <video width="100%" height="100%" class="video-container video-container-overlay" id="vid" controls autoplay muted loop>
    <source src="{{ section.settings.video }}" type="video/mp4">
  </video>
  {% endif %}
</div>

{% schema %}
  {
    "name": "Video",
    "settings": [
					{
						"type" : "header",
						"content" : "Heading"
					},
					{
						"type" : "text",
						"id" : "head1",
						"label" : "Heading"
						
					},
					{
        				"type": "font_picker",
        				"id": "font_head1",
        				"label": "Font type",
        				"default": "serif"
      				},
					{
    					"type": "range",
    					"id": "font_size_head1",
    					"min":  30,
    					"max":  50,
    					"step":  1,
    					"unit": "px" ,
    					"label": "Font size",
    					"default": 48
    				},
					{
						"type" : "header",
						"content" : "Heading 2"
					},
					{
						"type" : "text",
						"id" : "head2",
						"label" : "Heading 2"
						
					},
					{
        				"type": "font_picker",
        				"id": "font_head2",
        				"label": "Font type",
        				"default": "serif"
      				},
					{
    					"type": "range",
    					"id": "font_size_head2",
    					"min":  25,
    					"max":  35,
    					"step":  1,
    					"unit": "px" ,
    					"label": "Font size",
    					"default": 32
    				},
					{
						"type" : "header",
						"content" : "Button"
					},
					{
						"type" : "text",
						"id" : "button",
						"label" : "Button Name"
						
					},
					{
						"type" : "url",
						"id" : "video_url",
						"label" : "Fancy Box Video Link"
						
					},
					{
  						"type": "color",
  						"id": "bg_color",
  						"label": "Background colour",
  						"default": "#505af0"
					},
					{
  						"type": "color",
  						"id": "border_bg_color",
  						"label": "Border colour",
  						"default": "#505af0"
					},
					{
        				"type": "font_picker",
        				"id": "font_setting_btn",
        				"label": "Font type",
        				"default": "serif"
      				},
					{
    					"type": "range",
    					"id": "font_size_btn",
    					"min":  15,
    					"max":  35,
    					"step":  1,
    					"unit": "px" ,
    					"label": "Font size",
    					"default": 18
    				},
					{
      										"type": "select",
      										"id": "position",
      										"label": "Position",
      										"options": [
                                                          {
                                                            "value": "top",
                                                            "label":"top"
                                                          },
														  {
                                                            "value": "center",
                                                            "label":"center"
        												  },
                                                          {
                                                            "value": "bottom",
                                                            "label":"Bottom"
        													}
                                                          ],
      													"default": "center"
    				},
					{
      										"type": "select",
      										"id": "alignement",
      										"label": "Text Alignment",
      										"options": [
                                                          {
                                                            "value": "left",
                                                            "label":"left"
                                                          },
														  {
                                                            "value": "center",
                                                            "label":"center"
        												  },
                                                          {
                                                            "value": "right",
                                                            "label":"right"
        													}
                                                          ],
      													"default": "center"
    				},
					{
      										"type": "select",
      										"id": "alignment0",
      										"label": "Block Alignment",
      										"options": [
                                                          {
                                                            "value": "left",
                                                            "label":"left"
                                                          },
														  {
                                                            "value": "center",
                                                            "label":"center"
        												  },
                                                          {
                                                            "value": "right",
                                                            "label":"right"
        													}
                                                          ],
      													"default": "center"
    				},
					{
						"type" : "header",
						"content" : "Video"
					},
					{
      					"type": "checkbox",
      					"id": "show_iframe",
      					"label": "Youtube Video",
      					"default": true
    				},
					{
						"type" : "url",
						"id" : "video_url2",
						"label" : "Youtube video Link"
						
					},
					{
						"type" : "text",
						"id" : "videoid",
						"label" : "Youtube video ID"
						
					},
    				{
      					"type": "checkbox",
      					"id": "show_video",
      					"label": "Video",
      					"default": false
    				},
					{
						"type" : "url",
						"id" : "video",
						"label" : "Video Link"
						
					}
					

],
		"presets": [
    {
      "category": "video",
      "name": "Video Section"
    }
  ]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}

<!-- Video Section Css -->
<style>
  .video-wrapper
  {
  		width : 100%;
    	display : block;
    	max-width  : 100%;
   		position : relative;
  }
  .Video_wrapper_content
  {
  	position : absolute;
    text-align : {{ section.settings.alignement }};
    max-width: 100%;
    margin : auto;
    z-index: 1;
    color : #fff;
    padding :  25px;
  }
  .postion_center
  {
  	top: 50%;
  }
  
  .postion_bottom
  {
  	bottom : 5%;
  }
  .postion_top
  {
  	top : 15%;
  }
  
  .align_center {
    left: 50%;
    transform: translate(-50%, -50%);
}
  .align_right {
    right: -100px;
    transform: translate(-50%, -50%);
}
  .align_left 
  {
  	left : 15%;
    transform: translate(-50%, -50%);
  }
  h1.Video_wrapper_contenth1 {
    font-size: {{ section.settings.font_size_head1 | append:'px' }};
    font-weight: bold;
    margin-bottom: 15px;
    cursor: pointer;
    font-family: {{ font_family.family }};
    line-height: 1.3;
}
  h3.Video_wrapper_contenth3 {
    font-family: {{ head_family.family }};
    font-size: {{ section.settings.font_size_head2 | append:'px' }};
    font-weight: bold;
    cursor: pointer;
    line-height: 1.3;
}
  button.btn.Video_wrapper_contenthbtn {
    font-weight: 500;
    padding: 20px 35px;
    transition: .3s all;
    font-size: {{ section.settings.font_size_btn | append:'px' }};    
    cursor: pointer;
    display: inline-block;
    width: auto;
    outline: 0;
    line-height: 1;
    margin: 0;
    color: #fff;
    background: {{ section.settings.bg_color }};
    border: 2px solid  {{ section.settings.border_bg_color }};
    font-family : {{ button_family.family }}
}
  
@media (max-width:768px)
{
	h1.Video_wrapper_contenth1 {
    font-size: 18px;
}
  h3.Video_wrapper_contenth3 {
    font-size: 12PX;
}
  button.btn.Video_wrapper_contenthbtn
	{
  	padding: 6px 15px !important;
    font-size: 16px !important;
}
  iframe#vid {
    height: 500px;
}

}

  
@media (max-width : 500px)
  {
  		   iframe#vid {
    height: 400px;
}
  }
  @media (max-width : 600px)
  {
  .align_center
    {
     	transform: translate(-50%, -30%);
    }
    .postion_bottom {
    bottom: -25px;
}
    .postion_center {
    top: 35%;
}
    .align_left {
    transform: translate(-30%, -30%);
}
    .Video_wrapper_content
    {
    padding: 20px; 
    }
    .align_right {
    right: 0%;
    transform: translate(0%, -30%);
}
  }
</style>

      