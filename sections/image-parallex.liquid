<style>
  .image-parallax-section {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    overflow: hidden;
    border-radius: 20px;
    margin: 0 auto;
    background-color: #000;
  }

  .image-parallax-background {
    position: absolute;
    left: 0;
    width: 100%;
    height: 140%;

    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    z-index: 1;
    will-change: transform;
  }

  @media (max-width: 768px) {
    .image-parallax-section {
      padding-bottom: 110%;
      width: 100%;
      border-radius: 0;
    }
  }
</style>

<div class="image-parallax-section">
  {% if section.settings.image != blank %}
    <div class="image-parallax-background"
         style="background-image: url({{ section.settings.image | image_url: width: 1920 }});">
    </div>
  {% else %}
    <div class="image-parallax-background" style="background-color: #000;"></div>
  {% endif %}
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const sections = document.querySelectorAll('.image-parallax-section');
  if (!sections.length) return;

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReducedMotion) return;

  const observers = [];

  sections.forEach((section) => {
    const bg = section.querySelector('.image-parallax-background');
    if (!bg) return;

    let isInView = false;
    let ticking = false;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isInView = entry.isIntersecting;
        });
      },
      { threshold: [0, 1] }
    );

    observer.observe(section);
    observers.push(observer);

    const handleScroll = () => {
      if (!isInView || ticking) return;

      ticking = true;
      window.requestAnimationFrame(() => {
        const rect = section.getBoundingClientRect();
        const speed = 0.4;
        const moveY = rect.top * speed * -1;
        bg.style.transform = `translateY(${moveY}px)`;
        ticking = false;
      });
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
  });
});
</script>

{% schema %}
{
  "name": "Image New Parallax",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    }
  ],
  "presets": [
    {
      "name": "Image New Parallax"
    }
  ]
}
{% endschema %}
