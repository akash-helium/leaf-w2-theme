{% assign font_family = section.settings.font_setting %}


<div class="text">
      {% if section.settings.heading != blank %}
      <h2 class="press_section_head"> {{ section.settings.heading }}</h2>
      {% endif %}
       {% if section.settings.heading2 != blank %}
      <h5 class="press_section_head_desc">{{ section.settings.heading2 }}</h5>
      
    {% endif %}
</div>


<div class="press_section">
  	<div class="press_section_content">
      <div class="grid-collection">
    {% for block in section.blocks %}
    	  {% if block.type == 'Image' %}
    		<div class="icons_sec-{{ section.settings.press_sec }}">
              {% if block.settings.url != blank %}
              <a href="{{ block.settings.url }}" class="anchor_A">
              <div class="icons Image--lazyLoaded">
                
                 {%- include 'image-size', sizes: '200,400,600,700,800,900,1000,1200', image: block.settings.image -%}
        {%- assign image_url = block.settings.image  | img_url: '1x1' | replace: '_1x1.', '_{width}x.' -%}

        <img class="Image--lazyLoad Image--fadeIn" data-src="{{ image_url }}" data-widths="[{{ supported_sizes }}]" data-sizes="auto" alt="{{ block.settings.image.alt | escape }}" data-image-id="{{ block.settings.image.id }}">
        
                
                
              </div>
              <span class="icons_h3">{{ block.settings.heading }}</span>
              </a>
              {% else %}
              <div class="anchor_A">
              <div class="icons">
                     {%- include 'image-size', sizes: '200,400,600,700,800,900,1000,1200', image: block.settings.image -%}
        {%- assign image_url2 = block.settings.image  | img_url: '1x1' | replace: '_1x1.', '_{width}x.' -%}

        <img class="Image--lazyLoad Image--fadeIn" data-src="{{ image_url2 }}" data-widths="[{{ supported_sizes }}]" data-sizes="auto" alt="{{ block.settings.image.alt | escape }}" data-image-id="{{ block.settings.image.id }}">
        
              </div>
              <span class="icons_h3">{{ block.settings.heading }}</span>
              </div>
              {% endif %}
    		</div>
    	  {% endif %}
    {% endfor %}
      </div>
  </div>
</div>





{% schema %}
  {
    "name": "Press",
    "settings": [
					{
							"type" : "text",
							"id" : "heading",
							"label" : "Heading" 
					},
					{
    					"type": "range",
    					"id": "font_size1",
    					"min":  15,
    					"max":  35,
    					"step":  1,
    					"unit": "px" ,
    					"label": "Heading Font size",
    					"default": 20
    				},
					{
							"type" : "text",
							"id" : "heading2",
							"label" : "Heading 2" 
					},
					{
    					"type": "range",
    					"id": "font_size2",
    					"min":  10,
    					"max":  30,
    					"step":  1,
    					"unit": "px" ,
    					"label": "Heading 2 Font size",
    					"default": 14
    				},
					{
  						"type": "color",
  						"id": "bg_color",
  						"label": "Background colour",
  						"default": "#3e758e"
					},
					{
        				"type": "font_picker",
        				"id": "font_setting",
        				"label": "Font type",
        				"default": "serif"
      				},
					{
    					"type": "range",
    					"id": "font_size",
    					"min":  15,
    					"max":  35,
    					"step":  1,
    					"unit": "px" ,
    					"label": "Font size",
    					"default": 20
    				},
					{
						"type" : "header",
						"content" : "Image Settings"
					},
					{
    					"type": "range",
    					"id": "width",
    					"min":  20,
    					"max":  350,
    					"step":  10,
    					"unit": "px" ,
    					"label": "Image Width",
    					"default": 150
    				},
					{
    					"type": "range",
    					"id": "height",
    					"min":  20,
    					"max":  350,
    					"step":  10,
    					"unit": "px" ,
    					"label": "Image Height",
    					"default": 100
    				},
					{
    					"type": "range",
    					"id": "width_mobile",
    					"min":  20,
    					"max":  350,
    					"step":  10,
    					"unit": "px" ,
    					"label": "Image Width For mobile",
    					"default": 100
    				},
					{
    					"type": "select",
    					"id":  "press_sec",
    					"label": "Number of Images per row",
    				"options": [
								{
									"value": "two",
									"label": "two"
								},
								{
									"value": "three",
									"label": "three"
								},
								{
									"value": "four",
									"label": "four"
								},
								{
									"value": "five",
									"label": "five"
								}
      			]
    },
	{
    					"type": "select",
    					"id":  "press_sec_justify",
    					"label": "Alignment of Blocks",
    				"options": [
								{
									"value": "right",
									"label": "right"
								},
								{
									"value": "center",
									"label": "center"
								}
      			]
    },
								{
    					"type": "range",
    					"id": "grid_gap",
    					"min":  5,
    					"max":  50,
    					"step":  3,
    					"unit": "px" ,
    					"label": "Column gap",
    					"default": 5
    				}
				],
	"blocks": [
			{
				"type": "Image",
				"name": "Press",
				"settings": [
					{
						"type": "url",
						"id": "url",
						"label": "Link"
					},
					{
						"type": "image_picker",
						"id": "image",
						"label": "Image"
					},
					{
							"type" : "text",
							"id" : "imagealt",
							"label" : "Image alt" 
					},
					{
						"type": "text",
						"id": "heading",
						"label": "Content"
					}
				]
			}
		],
		"presets": [
    {
      "category": "press",
      "name": "Press Section"
    }
  ]
		
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}

<style>
  .press_section {
    display: block;
    width: 100%;
    max-width: 100%;
    background-color: {{ section.settings.bg_color }};
    margin-top : 50px;
}
.press_section_content {
    display: block;
    max-width: 1200px;
    width: 100%;
    padding: 25px 0px;
    color: #fff;
    margin: auto;
}
/*   .icons_sec {
    display: flex;
    width: 100%;
    max-width: 100%;
    justify-content: center;
    align-items: center;
} */

  .icons {
    height: 100%;
    min-height: {{ section.settings.height | append:'px' }};
    display: block;
    width: {{ section.settings.width | append:'px' }};
    max-width: 100%;
}
  h3.icons_h3 {
    font-size: 15px;
    font-family: Montserrat,sans-serif;
    font-weight: 300 !important;
}
  div#shopify-section-162702958366c6ce4a {
    margin: 50px 0px;
}
  .anchor_A {
    width: 100%;
    max-width: 100%;
    display: flex;
    align-items: center;
}
  span.icons_h3 {
    font-size: {{ section.settings.font_size | append:'px' }} ;
    font-family : {{ font_family.family  }};
    padding-left: 15px;
}
  h2.press_section_head {
    color: #000;
    line-height: 25px;
    font-size: {{ section.settings.font_size1 | append:'px' }};
    font-weight: 700;
    margin-bottom: 8px;
    text-align: center;
    text-transform: uppercase;
}
  h5.press_section_head_desc {
    color: #000;
    font-size: {{ section.settings.font_size2 | append:'px' }};
    line-height: 20px;
    text-align: center;
}
 
  .grid-collection {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
}
 .icons img
  {
  		width : 100%;
  }
  
    .icons_sec-three {
    display: flex;
    justify-content: center;
    align-items: center;
    flex: 0 0 calc(33% - 20px);
    color: white;
    margin-bottom: {{ section.settings.grid_gap | append:'px' }};
}
     .icons_sec-two {
    display: flex;
    justify-content: center;
    align-items: center;
    flex: 0 0 calc(50% - 20px);
    color: white;
    margin-bottom: {{ section.settings.grid_gap | append:'px' }};
}
     .icons_sec-four {
    display: flex;
    justify-content: center;
    align-items: center;
    flex: 0 0 calc(25% - 20px);
    color: white;
    margin-bottom: {{ section.settings.grid_gap | append:'px' }};
}
  .anchor_A
  {
    justify-content : {{ section.settings.press_sec_justify }};
  }
      .icons_sec-five {
    display: flex;
    justify-content: center;
    align-items: center;
    flex: 0 0 calc(16.33% - 20px);
    color: white;
    margin-bottom: {{ section.settings.grid_gap | append:'px' }};
}
  
  @media (max-width : 767px)
  {
   	.anchor_A
    {
    	flex-direction : column;
    }
   span.icons_h3 
    {
    text-align: center;
    max-width: 100%;
    line-height: 22px;
    padding-left : 0px;
	}
    .icons_sec {
    margin-bottom: 20px;
}
  }

@media (max-width : 575px)
{

  .icons_sec-three
  {
  	margin: 0px 10px 20px;
  }
   .icons_sec-two
  {
  	margin: 0px 10px 20px;
  }
   .icons_sec-four
  {
  	margin: 0px 10px 20px;
  }
   .icons_sec-five
  {
  	margin: 0px 10px 20px;
  }
  
  .icons
  {
  
    width : {{ section.settings.width_mobile | append:'px' }};
}
 
</style>