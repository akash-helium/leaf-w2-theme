{%- if section.blocks.size > 0 -%}
  {%- liquid
    assign section_id = 'hero-banner-' | append: section.id
  -%}

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>

  <div class="hero-banner-slider-wrapper">
    <div class="swiper" id="{{ section_id }}">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <div class="hero-banner-container">
              {%- if block.settings.video_url != blank -%}
                <video
                  class="hero-background-video"
                  src="{{ block.settings.video_url }}"
                  autoplay
                  loop
                  muted
                  playsinline
                ></video>
              {%- elsif block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 1920 }}"
                  alt="{{ block.settings.image.alt | default: 'Hero banner image' | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  class="hero-background-image">
              {%- else -%}
                 <div class="hero-background-placeholder"></div>
              {%- endif -%}

              <div class="hero-overlay"></div>

              <div class="hero-content">
                <div class="hero-text-content">
                  {%- if block.settings.heading != blank -%}
                    <h2 class="hero-heading">{{ block.settings.heading | escape }}</h2>
                  {%- endif -%}
                  {%- if block.settings.subheading != blank -%}
                    <p class="hero-subheading">{{ block.settings.subheading | escape }}</p>
                  {%- endif -%}
                </div>
                {%- if block.settings.button_text != blank and block.settings.button_link != blank -%}
                  <a href="{{ block.settings.button_link }}" class="hero-cta-button">
                    {{ block.settings.button_text | escape }}
                  </a>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
      <div class="swiper-pagination"></div>
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const swiperEl = document.querySelector('#{{ section_id }}');
      if (!swiperEl) return;

      const swiper = new Swiper(swiperEl, {
        loop: true,
        grabCursor: true,
        effect: 'fade',
        fadeEffect: { crossFade: true },
        pagination: {
          el: '#{{ section_id }} .swiper-pagination',
          clickable: true,
        },
        navigation: {
          nextEl: '#{{ section_id }} .swiper-button-next',
          prevEl: '#{{ section_id }} .swiper-button-prev',
        },
        {% if section.settings.autoplay %}
        autoplay: {
          delay: {{ section.settings.delay | default: 5000 }},
          disableOnInteraction: false,
        },
        {% endif %}
      });
    });
  </script>
{%- endif -%}

<style>
  .hero-banner-slider-wrapper {
    position: relative;
    width: 100%;
    height: 80vh;
    min-height: 500px;
    color: #ffffff;
  }
  .hero-banner-container {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-background-video,
  .hero-background-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  .hero-background-placeholder {
    width: 100%;
    height: 100%;
    background-color: #f0f0f0;
  }
  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.4);
    z-index: 2;
  }
  .hero-content {
    position: relative;
    z-index: 3;
    width: 90%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    text-align: center;
  }
  .hero-text-content {
    margin-top: auto;
    margin-bottom: auto;
  }
  .hero-heading {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 1rem;
  }
  .hero-subheading {
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.5;
    margin: 0;
  }
  .hero-cta-button {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid transparent;
    padding: 12px 30px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    border-radius: 5px;
    align-self: flex-end;
    margin-top: auto;
    margin-bottom: 2rem;
  }
  .hero-cta-button:hover {
    background-color: transparent;
    color: #ffffff;
    border-color: #ffffff;
  }
  .hero-banner-slider-wrapper .swiper-button-prev,
  .hero-banner-slider-wrapper .swiper-button-next {
    color: #ffffff;
    z-index: 4;
  }
  .hero-banner-slider-wrapper .swiper-pagination-bullet {
    background-color: rgba(255, 255, 255, 0.7);
  }
  .hero-banner-slider-wrapper .swiper-pagination-bullet-active {
    background-color: #ffffff;
  }

  @media (max-width: 768px) {
    .hero-content {
      text-align: center;
    }
    .hero-cta-button {
      align-self: center;
      margin-bottom: 4rem;
    }
  }
</style>

{% schema %}
{
  "name": "Hero Banner Slider",
  "tag": "section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "delay",
      "min": 3000,
      "max": 9000,
      "step": 1000,
      "unit": "ms",
      "label": "Autoplay Delay",
      "default": 5000
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "header",
          "content": "Background"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "Video URL",
          "accept": ["youtube", "vimeo"],
          "info": "Use a video URL for the background. This will override the image if both are provided."
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Your Hero Title"
        },
        {
          "type": "textarea",
          "id": "subheading",
          "label": "Subheading",
          "default": "Describe your slide here."
        },
        {
          "type": "header",
          "content": "Call to Action"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Banner Slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}