<style>
  .floating-cards-section {
    padding: 4rem 2rem;
    text-align: center;
    margin: 0 auto;
    max-width: 1200px;
  }

  .floating-cards__container {
    position: relative;
    width: 100%;
    max-width: 900px;
    margin: 0 auto 3rem;
    height: 450px;
  }

  .floating-cards__card {
    position: absolute;
    display: block;
    border-radius: 20%; /* Creates the squircle shape */
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    /* 
      We get the initial transform from inline styles.
      The hover transform is handled by the '--scale-on-hover' custom property.
      The animation transform is applied by Motion.js.
    */
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    will-change: transform; /* Performance optimization */
  }

  .floating-cards__card:hover {
    /* Uses the JS-calculated hover scale and !important to override the base scale */
    transform: scale(var(--scale-on-hover)) !important; 
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
    z-index: 10;
  }

  .floating-cards__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(30%);
    transition: filter 0.4s ease;
  }

  .floating-cards__card:hover .floating-cards__image {
    filter: grayscale(0%);
  }
  
  .floating-cards__image.placeholder-svg {
    background-color: #f2f2f2;
    border: 1px solid #e5e5e5;
  }

  .floating-cards__title {
    font-size: 2.5rem;
    font-weight: bold;
    margin: 0;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .floating-cards__container {
      height: 350px;
    }
    .floating-cards__title {
      font-size: 2rem;
    }
  }

  @media (max-width: 480px) {
    .floating-cards-section {
      padding: 3rem 1rem;
    }
    .floating-cards__container {
      height: 250px;
    }
    .floating-cards__title {
      font-size: 1.5rem;
    }
  }
</style>

<div class="floating-cards-section">
  <div class="floating-cards__container" id="floating-cards-container-{{ section.id }}">
    {%- for block in section.blocks -%}
      <a
        href="{{ block.settings.link | default: '#' }}"
        class="floating-cards__card"
        style="
          top: {{ block.settings.top_position }}%;
          left: {{ block.settings.left_position }}%;
          transform: scale({{ block.settings.scale }});
          width: {{ block.settings.width }}px;
          aspect-ratio: 1 / 1;
        "
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.image != blank -%}
          {%- assign image_widths = '100,150,200,250,300' -%}
          {{ block.settings.image | image_url: width: 300 | image_tag:
            class: 'floating-cards__image',
            loading: 'lazy',
            widths: image_widths,
            sizes: '(max-width: 768px) 100px, 150px'
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg floating-cards__image' }}
        {%- endif -%}
      </a>
    {%- endfor -%}
  </div>

  {%- if section.settings.title != blank -%}
    <h2 class="floating-cards__title">{{ section.settings.title | escape }}</h2>
  {%- endif -%}
</div>

<script type="module">
  // Using Skypack to import Motion - no install needed
  import { animate, stagger } from "https://cdn.skypack.dev/motion";

  // Ensure this runs only once for this section
  const container = document.getElementById('floating-cards-container-{{ section.id }}');
  const cards = container.querySelectorAll('.floating-cards__card');

  if (cards.length > 0) {
    // 1. Animate the cards with a gentle floating motion
    animate(
      cards,
      {
        transform: [
          'translateY(8px) translateX(-5px)',
          'translateY(-8px) translateX(5px)',
          'translateY(8px) translateX(-5px)',
        ]
      },
      {
        delay: stagger(0.25, { from: "first" }), // Each card starts slightly after the previous one
        duration: 15, // A long duration for a slow, subtle effect
        repeat: Infinity,
        easing: "ease-in-out",
      }
    );

    // 2. Set a CSS variable for hover scale
    // This allows the CSS to scale up from the user-defined size
    cards.forEach(card => {
        // We read the initial scale from the inline style
        const initialScale = parseFloat(card.style.transform.replace('scale(', '')) || 1;
        
        // We set a custom property for the hover state to be slightly larger
        card.style.setProperty('--scale-on-hover', initialScale * 1.15);
    });
  }
</script>

{% schema %}
{
  "name": "Floating Cards",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Join our community"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 12,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        },
        {
          "type": "range",
          "id": "top_position",
          "min": -10,
          "max": 90,
          "step": 1,
          "unit": "%",
          "label": "Top Position",
          "default": 50
        },
        {
          "type": "range",
          "id": "left_position",
          "min": -10,
          "max": 90,
          "step": 1,
          "unit": "%",
          "label": "Left Position",
          "default": 50
        },
        {
          "type": "range",
          "id": "width",
          "min": 50,
          "max": 250,
          "step": 5,
          "unit": "px",
          "label": "Card Width",
          "default": 150
        },
        {
          "type": "range",
          "id": "scale",
          "min": 0.5,
          "max": 1.5,
          "step": 0.1,
          "label": "Scale (Depth)",
          "default": 1.0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Floating Cards",
      "blocks": [
        { "type": "card", "settings": { "top_position": 10, "left_position": 15, "width": 180, "scale": 1.1 } },
        { "type": "card", "settings": { "top_position": 65, "left_position": 5, "width": 120, "scale": 0.9 } },
        { "type": "card", "settings": { "top_position": 50, "left_position": 30, "width": 100, "scale": 0.8 } },
        { "type": "card", "settings": { "top_position": 30, "left_position": 55, "width": 220, "scale": 1.3 } },
        { "type": "card", "settings": { "top_position": 15, "left_position": 80, "width": 130, "scale": 0.95 } },
        { "type": "card", "settings": { "top_position": 70, "left_position": 75, "width": 160, "scale": 1.0 } }
      ]
    }
  ]
}
{% endschema %}