
<div id="product-showcase-{{ section.id }}" class="product-showcase-container-wrapper" style="margin-bottom:12px;">
  {%- liquid
    assign first_block = section.blocks.first
    if section.blocks.size > 0 and first_block.settings.product
      assign first_product = first_block.settings.product
      assign first_product_brand = first_product.metafields.custom.feature_list.value.first | default: first_product.vendor

      assign first_product_description = first_product.metafields.custom.short_description.value
      if first_product_description == blank
        assign first_product_description = first_product.description | strip_html | truncate: 150
      endif
    endif
  -%}

  <div class="product-showcase-container">
    <!-- Info container with Subtext (and Title for desktop) -->
    <div class="product-info-container">
      <div class="product-text-content">
        <span class="product-card__subtext">{{ first_product_brand | default: 'Brand' }}</span>
        <!-- Title for Desktop View -->
        <h2 class="product-card__title product-card__title--desktop">
          {{ first_product.title | default: 'Product Title' }}
        </h2>
        <p class="product-card__description">
          {{ first_product_description | default: 'Product description goes here.' }}
        </p>
      </div>
      <a href="{{ first_product.url | default: '#' }}" class="product-card__button">View Product</a>
    </div>

    <!-- Column 1: Swiper Carousel (Visuals) -->
    <div class="product-carousel-container">
      <div class="swiper product-swiper">
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            {%- liquid
              assign product = block.settings.product
              if product == blank
                continue
              endif

              assign brand = product.metafields.custom.feature_list.value.first | default: product.vendor
              assign image = product.metafields.custom.transparent_hero_image.value | default: product.featured_image

              assign description = product.metafields.custom.short_description.value
              if description == blank
                assign description = product.description | strip_html | truncate: 150
              endif
            -%}
            <div
              class="swiper-slide"
              data-subtext="{{ brand | escape }}"
              data-title="{{ product.title | escape }}"
              data-description="{{ description | escape }}"
              data-url="{{ product.url }}"
              {{ block.shopify_attributes }}
            >
              <a class="product-card" href="{{ product.url }}">
                <div class="product-card__image-container">
                  <div class="product-card__gradient-bg"></div>
                  {%- if image != blank -%}
                    <img
                      src="{{ image | image_url: width: 800 }}"
                      alt="{{ image.alt | default: product.title }}"
                      class="product-card__image"
                      width="{{ image.width }}"
                      height="{{ image.height }}"
                      loading="lazy"
                    >
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'product-card__image placeholder' }}
                  {%- endif -%}
                </div>
              </a>
            </div>
          {%- endfor -%}
        </div>
      </div>
      <!-- UPDATED: Navigation buttons for all views -->
      <div class="swiper-navigation-custom">
        <div class="swiper-button-prev">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M10.8284 12.0007L15.7782 16.9504L14.364 18.3646L8 12.0007L14.364 5.63672L15.7782 7.05093L10.8284 12.0007Z"></path></svg>
        </div>
        <div class="swiper-button-next">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M13.1716 12.0007L8.22183 7.05093L9.63604 5.63672L16 12.0007L9.63604 18.3646L8.22183 16.9504L13.1716 12.0007Z"></path></svg>
        </div>
      </div>
      <!-- End of navigation buttons -->
    </div>

    <!-- NEW: Separate Title for Mobile View -->
    <div class="product-title-mobile-container">
      <h2 class="product-card__title product-card__title--mobile">
        {{ first_product.title | default: 'Product Title' }}
      </h2>
    </div>
  </div>
</div>

<style>

  #product-showcase-{{ section.id }} .swiper-slide{
  overflow:visible;
}
  #product-showcase-{{ section.id }} .product-showcase-container {
    width: 100%;
    max-width: 380px;
    background: black;
    border-radius: 24px;
    width:100vw;
    overflow-x:hidden;
    overflow:visible;
    padding: 25px;
    display: flex;
    flex-direction: column;
    margin:auto;
  }
  #product-showcase-{{ section.id }} .product-info-container {
    order: 1;
    text-align: center;
    opacity: 0;
  }
  #product-showcase-{{ section.id }} .product-carousel-container {
    order: 2;
    width: 100%;
    margin: 20px 0;
    position: relative;
  }
  #product-showcase-{{ section.id }} .product-title-mobile-container {
    order: 3;
    text-align: center;
    opacity: 0;
  }
  #product-showcase-{{ section.id }} .product-card__title--desktop {
    display: none;
  }
  #product-showcase-{{ section.id }} .product-card__subtext {
    display: block;
    font-size: 15px;
    color: #9E9E9E;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  #product-showcase-{{ section.id }} .product-card__title {
    font-size: 20px;
    font-weight: 700;
    color: #F5F5F5;
    margin: 0;
    min-height: 70px;
  }
  #product-showcase-{{ section.id }} .product-card__description,
  #product-showcase-{{ section.id }} .product-card__button {
    display: none;
  }
  #product-showcase-{{ section.id }} .product-swiper {
    width: 100%;
    height: 50vh;
    max-height: 400px;
  }
  #product-showcase-{{ section.id }} .product-card,
  #product-showcase-{{ section.id }} .product-card__image-container {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow:visible;
  }
  #product-showcase-{{ section.id }} .product-card__gradient-bg {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: radial-gradient(circle, var(--gradient-start, #04B344) 0%, var(--gradient-end, #1B66EF) 70%, transparent 100%);
    filter: blur(80px);
    z-index: 0;
    opacity: 0;
    transform: scale(0.5);
  }
  #product-showcase-{{ section.id }} .product-card__image {
    max-width: 100%;
    height: auto;
    position: relative;
    z-index: 1;
    opacity: 0;
    transform: translateY(-30px);
    mix-blend-mode: normal;
  }
  #product-showcase-{{ section.id }} .placeholder, #product-showcase-{{ section.id }} .placeholder > svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  #product-showcase-{{ section.id }} .swiper {
    overflow: visible !important;
  }

  /* ADDED: Mobile-first styles for navigation buttons */
  #product-showcase-{{ section.id }} .swiper-button-prev,
  #product-showcase-{{ section.id }} .swiper-button-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 40px; /* Smaller for mobile */
    height: 40px; /* Smaller for mobile */
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease;
    -webkit-backdrop-filter: blur(5px);
    backdrop-filter: blur(5px);
  }
  #product-showcase-{{ section.id }} .swiper-button-prev {
    left: 10px; /* Closer to edge on mobile */
  }
  #product-showcase-{{ section.id }} .swiper-button-next {
    left: auto; /* Closer to edge on mobile */
  }
  #product-showcase-{{ section.id }} .swiper-button-prev svg,
  #product-showcase-{{ section.id }} .swiper-button-next svg {
    fill: #ffffff;
    width: 24px; /* Smaller icon for mobile */
    height: 24px; /* Smaller icon for mobile */
  }
  #product-showcase-{{ section.id }} .swiper-button-disabled {
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
  }

  #product-showcase-{{ section.id }} .swiper-button-prev::after,
  #product-showcase-{{ section.id }} .swiper-button-next::after{
    display:none;
  }

  @media (min-width: 1024px) {
    #product-showcase-{{ section.id }} .product-showcase-container {
      flex-direction: row;
      max-width: 1200px;
      height: 650px;
      padding: 40px;
      align-items: center;
    }
    #product-showcase-{{ section.id }} .product-carousel-container {
      order: 1;
      width: 55%;
      height: 100%;
      margin: 0;
    }
    #product-showcase-{{ section.id }} .product-info-container {
      order: 2;
      width: 45%;
      text-align: left;
      padding-left: 40px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      height: 100%;
    }
    #product-showcase-{{ section.id }} .product-title-mobile-container {
      display: none;
    }
    #product-showcase-{{ section.id }} .product-card__title--desktop {
      display: block;
    }
    #product-showcase-{{ section.id }} .product-text-content {
      min-height: 200px;
    }
    #product-showcase-{{ section.id }} .product-card__title {
      font-size: 24px;
      min-height: 0;
    }
    #product-showcase-{{ section.id }} .product-card__description {
      display: block;
      color: #b0b0b0;
      font-size: 16px;
      line-height: 1.6;
      margin-top: 15px;
      min-height: 80px;
    }
    #product-showcase-{{ section.id }} .product-card__button {
      display: inline-block;
      background-color: #ffffff;
      color: #000000;
      padding: 14px 28px;
      border-radius: 50px;
      text-decoration: none;
      font-weight: 600;
      margin-top: 30px;
      transition: transform 0.2s ease, background-color 0.2s ease;
      width:fit-content;
      opacity: 0;
      transform: translateY(20px);
    }
    #product-showcase-{{ section.id }} .product-card__button:hover {
      transform: scale(1.05);
      background-color: #e0e0e0;
    }
    #product-showcase-{{ section.id }} .product-swiper {
      height: 100%;
      max-height: none;
    }

    /* UPDATED: Desktop-specific overrides for navigation buttons */
    #product-showcase-{{ section.id }} .swiper-button-prev,
    #product-showcase-{{ section.id }} .swiper-button-next {
        width: 48px; /* Larger for desktop */
        height: 48px; /* Larger for desktop */
    }
    #product-showcase-{{ section.id }} .swiper-button-prev:hover,
    #product-showcase-{{ section.id }} .swiper-button-next:hover {
        background-color: rgba(255, 255, 255, 0.2);
        transform: translateY(-50%) scale(1.05);
    }
    #product-showcase-{{ section.id }} .swiper-button-prev {
        left: 20px; /* More space on desktop */
    }
    #product-showcase-{{ section.id }} .swiper-button-next {
        right: 20px; /* More space on desktop */
    }
    #product-showcase-{{ section.id }} .swiper-button-prev svg,
    #product-showcase-{{ section.id }} .swiper-button-next svg {
        width: 28px; /* Larger icon for desktop */
        height: 28px; /* Larger icon for desktop */
    }
  }
</style>
<script type="module" src="https://cdn.skypack.dev/motion"></script>
<script
  type="module"
>
  import { animate } from "https://cdn.skypack.dev/motion";

  const container = document.getElementById('product-showcase-{{ section.id }}');

// --- DOM Element Selection ---
const infoContainer = container.querySelector('.product-info-container');
const mobileTitleContainer = container.querySelector('.product-title-mobile-container');
const subtextEl = container.querySelector('.product-card__subtext');
const titleEls = container.querySelectorAll('.product-card__title');
const descriptionEl = container.querySelector('.product-card__description');
const buttonEl = container.querySelector('.product-card__button');

// --- Original Animation for Images/Gradients ---
function animateImageIn(slide) {
    const image = slide.querySelector('.product-card__image');
    const gradient = slide.querySelector('.product-card__gradient-bg');
const gradientScale = window.innerWidth > 750 ? 1.25 : 1;

    animate(image, {
        opacity: [0, 1],
        filter: ["blur(10px)", "blur(0px)"],
        transform: ["scale(1.5) translateY(100px)", "scale(1.1) translateY(0px)"]
    }, { duration: 0.9, easing: [0.16, 1, 0.3, 1] });

    animate(gradient, {
        opacity: [0, 1],
        transform: ["scale(0.8)", `scale(${gradientScale})`]
    }, { duration: 0.6, easing: [0.16, 1, 0.3, 1] });
}

function animateImageOut(slide) {
    const image = slide.querySelector('.product-card__image');
    const gradient = slide.querySelector('.product-card__gradient-bg');

    animate(image, {
        opacity: [1, 0],
        filter: ["blur(0px)", "blur(10px)"],
        transform: ["scale(1)", "scale(0.8)"]
    }, { duration: 0.3, easing: [0.7, 0, 0.84, 0] });

    animate(gradient, {
        opacity: [1, 0],
        transform: ["scale(1)", "scale(0.8)"]
    }, { duration: 0.6, easing: [0.7, 0, 0.84, 0] });
}


// --- Function to Update Text and Button ---
async function updateText(slide) {
    const newSubtext = slide.dataset.subtext;
    const newTitle = slide.dataset.title;
    const newDescription = slide.dataset.description;
    const newUrl = slide.dataset.url;

    // 1. Fade out the text containers AND the button
    await Promise.all([
        animate(infoContainer, { opacity: 0 }, { duration: 0.2, easing: 'ease-out' }).finished,
        animate(mobileTitleContainer, { opacity: 0 }, { duration: 0.2, easing: 'ease-out' }).finished,
        animate(buttonEl, { opacity: 0, transform: "translateY(0px)" }, { duration: 0.2, easing: 'ease-out' }).finished
    ]);

    // 2. Update all content in the DOM
    subtextEl.textContent = newSubtext;
    descriptionEl.textContent = newDescription;
    buttonEl.href = newUrl;
    titleEls.forEach(el => el.textContent = newTitle);

    // 3. Fade in the new text
    animate(infoContainer, { opacity: 1 }, { duration: 0.3, delay: 0.1, easing: 'ease-in' });
    animate(mobileTitleContainer, { opacity: 1 }, { duration: 0.3, easing: 'ease-in' });
    animate(buttonEl, { opacity: 1, transform: "translateY(0px)" }, { duration: 0.4, delay: 0.2, easing: 'ease-in' });
}


// --- Swiper Initialization ---
const swiper = new Swiper('.product-swiper', {
    direction: 'horizontal',
    loop: true,
    autoplay: {
       delay: {{ section.settings.autoplay_speed }},
        disableOnInteraction: false,
    },
    speed: 800,
    grabCursor: true,
    navigation: {
        nextEl: '#product-showcase-{{ section.id }} .swiper-button-next',
        prevEl: '#product-showcase-{{ section.id }} .swiper-button-prev',
    },
    on: {
        init: function () {
            const initialSlide = this.slides[this.activeIndex];
            animateImageIn(initialSlide);

            // Set initial text content
            subtextEl.textContent = initialSlide.dataset.subtext;
            descriptionEl.textContent = initialSlide.dataset.description;
            buttonEl.href = initialSlide.dataset.url;
            titleEls.forEach(el => el.textContent = initialSlide.dataset.title);

            // Animate in initial text
            const textAnimationProps = {
                opacity: 1,
                filter: ["blur(10px)", "blur(0px)"],
                transform: ["scale(0.8)", "scale(1)"]
            };
            animate(infoContainer, textAnimationProps, { duration: 0.5 });
            animate(mobileTitleContainer, textAnimationProps, { duration: 0.5, delay: 0.1 });
            
            animate(buttonEl, { opacity: 1, transform: "translateY(0px)" }, { duration: 0.4, delay: 0.3, easing: 'ease-in' });
        },

        slideChangeTransitionStart: function () {
            animateImageOut(this.slides[this.previousIndex]);
            updateText(this.slides[this.activeIndex]);
        },

        slideChangeTransitionEnd: function () {
            animateImageIn(this.slides[this.activeIndex]);
        }
    }
});
</script>

{% schema %}
{
  "name": "Product Showcase Swiper",
  "tag": "section",
  "class": "shopify-section--product-showcase-swiper",
  "settings": [
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2000,
      "max": 9000,
      "step": 1000,
      "unit": "ms",
      "label": "Autoplay Delay",
      "default": 5000
    }
  ],
  "blocks": [
    {
      "type": "product_slide",
      "name": "Product Slide",
      "limit": 6,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Showcase Swiper",
      "blocks": [
        { "type": "product_slide" },
        { "type": "product_slide" },
        { "type": "product_slide" }
      ]
    }
  ]
}
{% endschema %}
