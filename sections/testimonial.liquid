<style>
  .testimonial-section-wrapper {
    padding: 60px 20px;
    color: var(--brand-primary-color-font-body);
    position: relative;
    overflow: hidden;
  }
  .swiper-button-next{
    display:none;
  }
  .swiper-button-prev{
    display:none
  }

  .testimonial-section-wrapper::before {
    left: 0;
  }
  .testimonial-section-wrapper::after {
    right: 0;
  }

  .testimonial-slider {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    overflow: hidden;
  }

  .swiper-slide {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .testimonial-card {
    background-color: var(--bg-card); 
    border-radius: 16px;
    padding: 40px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    text-align: center;
    max-width: 700px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 250px;
  }

  .testimonial-btn {
    background:var(--brand-bg-gradient);
    border: 1px solid rgba(4, 179, 68, 0.2);
    border-radius: 50px;
    padding: 10px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-align: center;
    margin-bottom: 30px;
  }

  .testimonial-btn .stars {
    color: #FFC107;
    font-size: 16px;
    letter-spacing: 1px;
    line-height: 1;
  }

  .testimonial-btn .review-count {
    background: var(--brand-primary-text-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 600;
    font-size: 16px;
    white-space: nowrap;
  }

  .testimonial-quote {
    font-size: 1.6em;
    line-height: 1.5;
    font-weight: 500;
    color: var(--brand-secondary-color-font);
    margin: 0 0 35px 0;
    padding: 0;
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-top: auto;
  }

.author-avatar {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid {{ section.settings.accent_color }};
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

  .author-details {
    text-align: left;
  }

  .author-name {
    font-size: 1.1em;
    font-weight: 600;
    color: #222;
    margin: 0;
    line-height: 1.3;
  }

  .author-designation {
    font-size: 0.9em;
    color: #777;
    margin: 0;
    line-height: 1.3;
  }

  .swiper-button-next,
  .swiper-button-prev {
    color: var(--brand-secondary-color-font);
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 44px;
    height: 44px;
  }

  .swiper-button-prev {
    left: 10px;
  }

  .swiper-button-next {
    right: 10px;
  }

  .swiper-button-prev.swiper-button-disabled,
  .swiper-button-next.swiper-button-disabled {
    opacity: 0.3;
  }

  @media (max-width: 768px) {
    .testimonial-card {
      padding: 30px 20px;
      min-height: 300px;
    }
    .testimonial-quote {
      font-size: 1.3em;
    }
    .testimonial-btn {
      margin-bottom: 20px;
    }
    .testimonial-section-wrapper {
      padding: 40px 10px;
    }
    .swiper-button-next,
    .swiper-button-prev {
      width: 36px;
      height: 36px;
      left: 5px;
      right: 5px;
    }
    .swiper-slide {
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .testimonial-card {
      padding: 25px 15px;
      min-height: 280px;
      max-width: 95%;
    }
    .author-info {
      flex-direction: column;
      text-align: center;
    }
    .author-details {
      text-align: center;
    }
    .swiper-button-next,
    .swiper-button-prev {
      width: 30px;
      height: 30px;
      left: 0px;
      right: 0px;
      top: 45%;
    }
    .swiper-slide {
      width: 100%;
    }
  }

  @media (min-width: 1024px) {
    .testimonial-slider {
      max-width: 1200px;
    }
    .testimonial-card {
      max-width: 1000px;
    }
  }
</style>

<div class="testimonial-section-wrapper">
  <div class="swiper-container testimonial-slider">
    <div class="swiper-wrapper">
      {%- for block in section.blocks -%}
        <div class="swiper-slide">
          <div class="testimonial-card">

          

            <blockquote class="testimonial-quote">
              “{{ block.settings.review_text }}”
            </blockquote>

            <div class="author-info">
              {%- if block.settings.author_image != blank -%}
                <img
                  src="{{ block.settings.author_image | image_url: width: 120, height: 120, crop: 'center' }}"
                  alt="{{ block.settings.author_name | escape }}"
                  loading="lazy"
                  class="author-avatar"
                >
              {%- else -%}
                <div class="author-avatar" style="background-color: #eee;"></div>
              {%- endif -%}
              <div class="author-details">
                <h3 class="author-name">{{ block.settings.author_name }}</h3>
                <p class="author-designation">{{ block.settings.author_designation }}</p>
              </div>
            </div>

          </div>
        </div>
      {%- else -%}
        <div class="swiper-slide">
          <div class="testimonial-card">
            <div class="testimonial-btn">
              <div class="stars">
                <span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span>
              </div>
   
            </div>
            <blockquote class="testimonial-quote">
              “This is a placeholder testimonial. Go to Theme Customize -> Sections -> Customer Testimonials to add your own reviews.”
            </blockquote>
            <div class="author-info">
              <img src="https://via.placeholder.com/60x60" alt="Placeholder Avatar" class="author-avatar">
              <div class="author-details">
                <h3 class="author-name">Placeholder Name</h3>
                <p class="author-designation">Company CEO</p>
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
    {%- endif -%}

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const testimonialSlider = new Swiper('.testimonial-slider', {
      loop: true,
      spaceBetween: 30,
      grabCursor: true,
      centeredSlides: true,
      slidesPerView: 1,
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
      autoplay: {
        delay: 5000,
        disableOnInteraction: false,
      },
      observer: true,
      observeParents: true,
      breakpoints: {
        768: {},
        1024: {}
      }
    });

    if (Shopify.designMode) {
      document.addEventListener('shopify:section:load', function(event) {
        if (event.detail.sectionId === '{{ section.id }}') {
          const newSlider = new Swiper(event.target.querySelector('.testimonial-slider'), {
            loop: true,
            spaceBetween: 30,
            grabCursor: true,
            centeredSlides: true,
            slidesPerView: 1,
            navigation: {
              nextEl: '.swiper-button-next',
              prevEl: '.swiper-button-prev',
            },
            autoplay: {
              delay: 5000,
              disableOnInteraction: false,
            },
            observer: true,
            observeParents: true,
            breakpoints: {
              768: {}, 1024: {}
            }
          });
        }
      });

      document.addEventListener('shopify:section:unload', function(event) {
        if (event.detail.sectionId === '{{ section.id }}') {
          const sliderElement = event.target.querySelector('.testimonial-slider');
          if (sliderElement && sliderElement.swiper) {
            sliderElement.swiper.destroy(true, true);
          }
        }
      });
    }
  });
</script>


{% schema %}
{
  "name": "Customer Testimonials",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Colors"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Avatar Border)",
      "default": "#E6F6EE",
      "info": "This color is now primarily for the author avatar border."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Text",
          "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Maecenas massa magna, lobortis id ultricies eget, luctus non dolor. Quisque at lacus blandit, hendrerit neque ac, volutpat diam."
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating (out of 5)",
          "default": 5
        },
        
        {
          "type": "image_picker",
          "id": "author_image",
          "label": "Author Image"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "Helen Smith"
        },
        {
          "type": "text",
          "id": "author_designation",
          "label": "Author Designation",
          "default": "VP, Chairman Industries"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Testimonials",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}