{% schema %}
{
  "name": "Instagram_Stories",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Moments Captured with @leaf"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Follow us"
    }
  ],
  "blocks": [
    {
      "type": "image_item",
      "name": "Image Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Stories"
    }
  ]
}
{% endschema %}

<section class="feature-story-section">
  <div class="feature-story-header">
    <h2 id="instagram-stories-title" class="heading-size">{{ section.settings.section_title }}</h2>
    <a href="{{ section.settings.button_link }}" class="feature-story-btn btn-secondary desktop-only">
      <span>{{- section.settings.button_text -}}</span>
      <img src="{{ 'instagram_svg.png' | asset_url }}" alt="Instagram icon" class="instagram-icon">
    </a>
  </div>

  <div class="feature-story-grid">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% if block.settings.image %}
          <div class="feature-story-card">
            <a href="{{ block.settings.link | default: 'https://www.instagram.com/leaf.studios/' }}">
              <img
                src="{{ block.settings.image | img_url: '800x' }}"
                alt="{{ block.settings.image.alt | default: 'Instagram Story Image' }}"
                class="feature-story-image"
                loading="lazy"
              >
              <div class="feature-story-overlay">
                <img
                  src="{{ 'instagram_svg.png' | asset_url }}"
                  alt="Instagram icon"
                  class="feature-story-overlay-icon"
                >
              </div>
            </a>
          </div>
        {% endif %}
      {% endfor %}
    {% else %}
      <p>Add image items to this section in the theme editor.</p>
    {% endif %}
  </div>

  <div class="mobile-only feature-story-btn-container">
    <a href="{{ section.settings.button_link }}" class="feature-story-btn btn-secondary">
      <span>{{- section.settings.button_text -}}</span>
      <img src="{{ 'instagram_svg.png' | asset_url }}" alt="Instagram icon" class="instagram-icon">
    </a>
  </div>
</section>

<style>
  .feature-story-section {
    padding: 60px 40px;
    margin: 0 auto;
  }

  .feature-story-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
    flex-wrap: wrap;
    gap: 16px;
  }

  .feature-story-header h2 {
    font-size: 28px;
    margin: 0;
    opacity: 0;
    transform: translateX(-50px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
    text-align: center;
  }

  .feature-story-header h2.fade-in-x-visible {
    opacity: 1;
    transform: translateX(0);
  }

  @media (min-width: 769px) {
    .feature-story-header h2 {
      text-align: left;
    }
  }

  .feature-story-btn {
  
    border: 1px solid rgba(0, 0, 0, 1);
    width: 200px;
    height: 50px;
    border-radius: 50px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  
  }

  .instagram-icon {
    width: 20px;
    height: 20px;
    margin-left: 8px;
    vertical-align: middle;
  }

  .feature-story-btn span {
    white-space: nowrap;
    color:var(--brand-text-muted);
  }

  .feature-story-grid {
    display: flex;
    overflow-x: auto;
    gap: 24px;
    padding: 0 0 20px;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    align-items: flex-start;
  }

  .feature-story-grid::-webkit-scrollbar {
    display: none;
  }

  .feature-story-grid {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .feature-story-card {
    flex: 0 0 auto;
    width: 300px;
    scroll-snap-align: start;
    overflow: hidden;
    border-radius: 16px;
    position: relative;
  }

  .feature-story-card a {
    display: block;
    text-decoration: none;

    position: relative;
    height: 100%;
    width: 100%;
  }

  .feature-story-image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 16px;
    object-fit: cover;
    aspect-ratio: 1;
    transition: filter 0.3s ease;
  }

  .feature-story-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease, background-color 0.3s ease;
    z-index: 1;
  }

  .feature-story-overlay-icon {
    width: 40px;
    height: 40px;
    filter: invert(100%);
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .feature-story-card:hover .feature-story-image {
    filter: brightness(0.6);
  }

  .feature-story-card:hover .feature-story-overlay {
    opacity: 1;
    background-color: rgba(0, 0, 0, 0.4);
  }

  .feature-story-card:hover .feature-story-overlay-icon {
    opacity: 1;
    transform: scale(1);
  }

  .desktop-only {
    display: flex;
  }

  .mobile-only {
    display: none;
  }

  .feature-story-btn-container {
    text-align: center;
    margin-top: 40px;
  }

  @media (max-width: 768px) {
    .feature-story-section {
      padding: 40px 0;
    }

   .feature-story-header {
      flex-direction: column;
      align-items: center;
      margin-bottom: 24px;
      padding: 0 20px;
    }

    .feature-story-header h2 {
      width: 100%;
    }

    .feature-story-grid {
      padding: 0 16px 16px;
    }

    .feature-story-card {
      width: 80vw;
    }

    .desktop-only {
      display: none;
    }

    .mobile-only {
      display: flex;

    }

    .feature-story-card .feature-story-overlay {
      opacity: 0;
      background-color: rgba(0, 0, 0, 0.2);
    }
    .feature-story-card .feature-story-overlay-icon {
      opacity: 0;
      transform: scale(0.8);
    }
     .feature-story-card .feature-story-image {
        filter: brightness(1);
    }
  }

  @media (max-width: 480px) {
    .feature-story-section {
      padding: 20px 0;
    }
    .feature-story-grid {
      padding: 0 10px 10px;
      gap: 15px;
    }
    .feature-story-card {
      width: 90vw;
    }
    .feature-story-header {
      padding: 0 10px;
    }
    .feature-story-btn-container .feature-story-btn {
        margin: auto;
    }
  }
</style>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const instagramStoriesTitleElement = document.getElementById('instagram-stories-title');

    if (!instagramStoriesTitleElement) {
      return;
    }

    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.1
    };

    const observerCallback = (entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('fade-in-x-visible');
          observer.unobserve(entry.target);
        }
      });
    };

    const observer = new IntersectionObserver(observerCallback, observerOptions);
    observer.observe(instagramStoriesTitleElement);
  });
</script>
