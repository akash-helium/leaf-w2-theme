<section class="new-testimonial-section">
    {% if section.settings.heading != blank %}
  <h2 class="new-testimonial-heading {{ section.settings.heading_align }}">
    {{ section.settings.heading }}
  </h2>
{% endif %}
  <div class="swiper new-testimonial-slider">
  <div class="swiper-wrapper">

    {% for block in section.blocks %}
      <div class="swiper-slide">

        <div class="new-testimonial-card">

          <!-- IMAGE -->
          <div class="new-testimonial-image">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 500 }}">
            {% endif %}
          </div>

          <!-- CONTENT -->
          <div class="new-testimonial-content">
            <h3>{{ block.settings.title }}</h3>

            <div class="stars">
              {% for i in (1..block.settings.stars) %}
                ★
              {% endfor %}
            </div>

            <p>{{ block.settings.content }}</p>

            {% if block.settings.button_label != blank %}
              <a href="{{ block.settings.button_link }}" class="btn">
                {{ block.settings.button_label }}
              </a>
            {% endif %}
          </div>

        </div>

      </div>
    {% endfor %}

  </div>

  <!-- Arrows -->
  <div class="swiper-button-next"></div>
  <div class="swiper-button-prev"></div>
</div>
</section>
<style>
.new-testimonial-section {
  padding: 50px 20px;
}

.new-testimonial-slider {
  display: flex;
  gap: 20px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
}

.new-testimonial-slide {
  min-width: 50%;
  scroll-snap-align: start;
}

.new-testimonial-card {
    background: transparent;
    border-radius: 16px;
    padding: 20px;
    box-shadow: 0px 0px 10px 4px rgba(255, 255, 255, 0.18);
    text-align: center;
    max-width: 700px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 10px;
}

/* IMAGE */
.new-testimonial-image img {
    width: 200px;
    height: 200px;
    object-fit: cover;
    border-radius: 10px;
    min-width: 200px;
}

/* CONTENT */
.new-testimonial-content h3 {
  font-size: 20px;
  margin-bottom: 10px;
}

.stars {
  color: gold;
  margin-bottom: 10px;
}

.new-testimonial-content p {
  font-size: 14px;
  margin-bottom: 15px;
}

.btn {
    display: inline-block;
    background: #fff;
    color: #000;
    padding: 8px 14px;
    text-decoration: none;
    border-radius: 5px;
}

/* MOBILE */
@media (max-width: 768px) {
  .new-testimonial-slide {
    min-width: 100%;
  }

  .new-testimonial-card {
    flex-direction: column;
    text-align: center;
  }

  .new-testimonial-image img {
    width: 100%;
    height: auto;
  }
}
.new-testimonial-heading {
    font-size: 28px;
    margin-bottom: 20px;
    font-weight: 600;
}

.new-testimonial-heading.left {
  text-align: left;
}

.new-testimonial-heading.center {
  text-align: center;
}

.new-testimonial-heading.right {
  text-align: right;
}
.new-testimonial-content {
    text-align: left;
    padding: 0 20px;
}
.new-testimonial-section .swiper-button-next,
.new-testimonial-section .swiper-button-prev {
    display: flex !important;
    background: #fff;
    padding: 20px;
    background-color: rgb(20 20 20);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50%;
}
.new-testimonial-section .swiper-button-next:after,
.new-testimonial-section .swiper-button-prev:after {
color: #fff;
font-size: 14px;
}

@media screen and (max-width: 800px){
.new-testimonial-content {
    text-align: left;
    padding: 20px 0px;
}
.new-testimonial-section .swiper-button-next {
    left: auto !important;
    right: 0 !important;
}
}
    </style>

   
    {% schema %}
{
  "name": "New new-testimonials",
  "settings": [
    {
  "type": "text",
  "id": "heading",
  "label": "Section Heading",
  "default": "What Our Customers Say"
},
{
  "type": "select",
  "id": "heading_align",
  "label": "Heading Alignment",
  "options": [
    { "value": "left", "label": "Left" },
    { "value": "center", "label": "Center" },
    { "value": "right", "label": "Right" }
  ],
  "default": "center"
}
  ],
  "blocks": [
    {
      "type": "new-testimonial",
      "name": "new-testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Customer Name"
        },
        {
          "type": "range",
          "id": "stars",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Read More"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "New new-testimonials"
    }
  ]
}
{% endschema %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
document.addEventListener("DOMContentLoaded", function () {
  new Swiper(".new-testimonial-slider", {
    loop: true,
    spaceBetween: 20,

    navigation: {
      nextEl: ".swiper-button-next",
      prevEl: ".swiper-button-prev",
    },

    breakpoints: {
      0: {
        slidesPerView: 1
      },
      768: {
        slidesPerView: 2
      }
    }
  });
});
</script>